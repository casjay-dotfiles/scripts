user_install && __options "$@"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Send all output to /dev/null
__devnull() {
  tee &>/dev/null && exitCode=0 || exitCode=1
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -'
# Send errors to /dev/null
__devnull2() {
  [ -n "$1" ] && local cmd="$1" && shift 1 || return 1
  "$cmd" "$@" 2>/dev/null && exitCode=0 || exitCode=1
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -'
# See if the executable exists
__cmd_exists() {
  local exitCode=0
  [ -n "$1" ] || return 0
  for cmd in "$@"; do
    if builtin command -v "$cmd" &>/dev/null; then
      exitCode=$((exitCode + 0))
    else
      exitCode=$((exitCode + 1))
    fi
  done
  [ $exitCode -eq 0 ] || exitCode=3
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Check for a valid internet connection
__am_i_online() {
  local exitCode=0
  curl -q -LSsfI --max-time 2 --retry 1 "${1:-https://1.1.1.1}" 2>&1 | grep -qi 'server:.*cloudflare' || exitCode=4
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# colorization
if [ -n "${NO_COLOR+x}" ] || [ "$SHOW_RAW" = "true" ]; then
  NC=""
  RESET=""
  BLACK=""
  RED=""
  GREEN=""
  YELLOW=""
  BLUE=""
  PURPLE=""
  CYAN=""
  WHITE=""
  ORANGE=""
  LIGHTRED=""
  BG_GREEN=""
  BG_RED=""
  ICON_INFO="[ info ]"
  ICON_GOOD="[ ok ]"
  ICON_WARN="[ warn ]"
  ICON_ERROR="[ error ]"
  ICON_QUESTION="[ ? ]"
  printf_column() { tee | grep '^'; }
  printf_color() { printf '%b' "$1" | tr -d '\t' | sed '/^%b$/d;s,\x1B\[[0-9;]*[a-zA-Z],,g'; }
else
  printf_color() { printf "%b" "$(tput setaf "${2:-7}" 2>/dev/null)" "$1" "$(tput sgr0 2>/dev/null)"; }
fi
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Additional printf_ colors
__printf_head() { printf_blue "$1"; }
__printf_opts() { printf_purple "$1"; }
__printf_line() { printf_cyan "$1"; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
# output version
__version() { printf_cyan "$VERSION"; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
# list options
__list_options() {
  printf_color "$1: " "$5"
  echo -ne "$2" | sed 's|:||g;s/'$3'/ '$4'/g' | tr '\n' ' '
  printf_newline
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# create the config file
__gen_config() {
  local NOTIFY_CLIENT_NAME="$APPNAME"
  if [ "$INIT_CONFIG" != "TRUE" ]; then
    printf_blue "Generating the config file in"
    printf_cyan "$ANIME_DL_CONFIG_DIR/$ANIME_DL_CONFIG_FILE"
  fi
  [ -d "$ANIME_DL_CONFIG_DIR" ] || mkdir -p "$ANIME_DL_CONFIG_DIR"
  [ -d "$ANIME_DL_CONFIG_BACKUP_DIR" ] || mkdir -p "$ANIME_DL_CONFIG_BACKUP_DIR"
  [ -f "$ANIME_DL_CONFIG_DIR/$ANIME_DL_CONFIG_FILE" ] &&
    cp -Rf "$ANIME_DL_CONFIG_DIR/$ANIME_DL_CONFIG_FILE" "$ANIME_DL_CONFIG_BACKUP_DIR/$ANIME_DL_CONFIG_FILE.$$"
  cat <<EOF >"$ANIME_DL_CONFIG_DIR/$ANIME_DL_CONFIG_FILE"
# Settings for anime-dl
ANIME_DL_SAVE_DIR="${ANIME_DL_SAVE_DIR:-}"
ANIME_DL_SOURCE_FILE="${ANIME_DL_SOURCE_FILE:-}"
ANIME_DL_UPDATE_URL="${ANIME_DL_UPDATE_URL:-}"
ANIME_DL_BIN_DIR="${ANIME_DL_BIN_DIR:-}"
ANIME_DL_DEFAULT_OPTS="${ANIME_DL_DEFAULT_OPTS:-}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Color Settings
ANIME_DL_OUTPUT_COLOR_1="${ANIME_DL_OUTPUT_COLOR_1:-}"
ANIME_DL_OUTPUT_COLOR_2="${ANIME_DL_OUTPUT_COLOR_2:-}"
ANIME_DL_OUTPUT_COLOR_GOOD="${ANIME_DL_OUTPUT_COLOR_GOOD:-}"
ANIME_DL_OUTPUT_COLOR_ERROR="${ANIME_DL_OUTPUT_COLOR_ERROR:-}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Notification Settings
ANIME_DL_NOTIFY_ENABLED="${ANIME_DL_NOTIFY_ENABLED:-}"
ANIME_DL_GOOD_NAME="${ANIME_DL_GOOD_NAME:-}"
ANIME_DL_ERROR_NAME="${ANIME_DL_ERROR_NAME:-}"
ANIME_DL_GOOD_MESSAGE="${ANIME_DL_GOOD_MESSAGE:-}"
ANIME_DL_ERROR_MESSAGE="${ANIME_DL_ERROR_MESSAGE:-}"
ANIME_DL_NOTIFY_CLIENT_NAME="${ANIME_DL_NOTIFY_CLIENT_NAME:-}"
ANIME_DL_NOTIFY_CLIENT_ICON="${ANIME_DL_NOTIFY_CLIENT_ICON:-}"
ANIME_DL_NOTIFY_CLIENT_URGENCY="${ANIME_DL_NOTIFY_CLIENT_URGENCY:-}"

EOF
  if builtin type -t __gen_config_local | grep -q 'function'; then __gen_config_local; fi
  if [ -f "$ANIME_DL_CONFIG_DIR/$ANIME_DL_CONFIG_FILE" ]; then
    [ "$INIT_CONFIG" = "TRUE" ] || printf_green "Your config file for $APPNAME has been created"
    . "$ANIME_DL_CONFIG_DIR/$ANIME_DL_CONFIG_FILE"
    exitCode=0
  else
    printf_red "Failed to create the config file"
    exitCode=1
  fi
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Help function - Align to 50
__help() {
  __printf_head "- - - - - - - - - - - - - - - - - - - - - - - - -"
  __printf_opts "anime-dl:  Search for anime to download or watch - $VERSION"
  __printf_head "- - - - - - - - - - - - - - - - - - - - - - - - -"
  __printf_line "Usage: anime-dl [options] [query]"
  __printf_line "-d                                     - Download episodes (default)"
  __printf_line "-q best|worst|720p|1080p               - Set video quality"
  __printf_line "--episode|-r|-a 1-4                    - Episode or range of episodes"
  __printf_line "--select-nth 2                         - Select the nth search result"
  __printf_line "-p /path/to/dir                        - Download folder (default: ~/Videos/Anime)"
  __printf_line "--dir /path/to/dir                     - Sets the working directory"
  __printf_line "-c                                     - Continue watching from history"
  __printf_line "-v                                     - Use VLC as the media player"
  __printf_line "-s                                     - Watch together using Syncplay (mpv only)"
  __printf_line "--nextep-countdown                     - Show a countdown to the next episode"
  __printf_line "--dub                                  - Use the dubbed version"
  __printf_line "--skip                                 - Skip the intro (mpv only, needs ani-skip)"
  __printf_line "--rofi, --dmenu                        - Use rofi or dmenu instead of fzf"
  __printf_line "--no-detach, --exit-after-play         - Keep the player in the terminal"
  __printf_line "--update                               - Update ani-cli from the latest release"
  __printf_head "- - - - - - - - - - - - - - - - - - - - - - - - -"
  __printf_opts "Other Options"
  __printf_head "- - - - - - - - - - - - - - - - - - - - - - - - -"
  __printf_line "--help                                 - Shows this message"
  __printf_line "--config                               - Generate user config file"
  __printf_line "--version                              - Show script version"
  __printf_line "--options                              - Shows all available options"
  __printf_line "--debug                                - Enables script debugging"
  __printf_line "--no-color                             - Disable ANSI color output"
  __printf_head "- - - - - - - - - - - - - - - - - - - - - - - - -"
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# check if arg is a builtin option
__is_an_option() { if [[ "$ARRAY" == *"${1:-^}"* ]]; then return 1; else return 0; fi; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Is current user root
__user_is_root() {
  { [ $(id -u) -eq 0 ] || [ $EUID -eq 0 ] || [ "$WHOAMI" = "root" ]; } && return 0 || return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Is current user not root
__user_is_not_root() {
  if { [ $(id -u) -eq 0 ] || [ $EUID -eq 0 ] || [ "$WHOAMI" = "root" ]; }; then return 1; else return 0; fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Check if user is a member of a group that grants sudo
__sudo_group() {
  case " $(id -nG "${1:-$USER}" 2>/dev/null) " in
  *" wheel "* | *" sudo "* | *" admin "*) return 0 ;;
  esac
  return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Test if user has access to sudo: passwordless sudo works, or the user is in a sudo group. Never prompts.
__can_i_sudo() {
  __cmd_exists sudo || return 1
  sudo -n true &>/dev/null </dev/null && return 0
  __sudo_group "${1:-$USER}" && return 0
  return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# # Get sudo password
__sudoask() {
  ask_for_password sudo true && return 0 || return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Run sudo
__sudorun() {
  __sudoif && __cmd_exists sudo && sudo -HE "$@" || { __sudoif && eval "$@"; }
  return $?
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# User can run sudo
__sudoif() {
  __user_is_root && return 0
  __can_i_sudo "${RUN_USER:-$USER}" && return 0
  __user_is_not_root && __sudoask && return 0 || return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Run command as root
requiresudo() {
  if [ "$ANIME_DL_REQUIRE_SUDO" = "yes" ] && [ -z "$ANIME_DL_REQUIRE_SUDO_RUN" ]; then
    export ANIME_DL_REQUIRE_SUDO="no"
    export ANIME_DL_REQUIRE_SUDO_RUN="true"
    __sudo "$@"
    exit $?
  else
    return 0
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Execute sudo
__sudo() {
  CMD="${1:-echo}" && shift 1
  CMD_ARGS="${*:--e "${RUN_USER:-$USER}"}"
  SUDO="$(builtin command -v sudo 2>/dev/null || echo 'eval')"
  [ "${SUDO##*/}" = "sudo" ] && OPTS="--preserve-env=PATH -HE"
  if __sudoif; then
    export PATH="$PATH"
    $SUDO ${OPTS:-} $CMD $CMD_ARGS && true || false
    exitCode=$?
  else
    printf '%s\n' "This requires root to run"
    exitCode=1
  fi
  return ${exitCode:-1}
}
# End of sudo functions
# - - - - - - - - - - - - - - - - - - - - - - - - -
__trap_exit() {
  exitCode=${exitCode:-0}
  [ -f "$ANIME_DL_TEMP_FILE" ] && rm -Rf "$ANIME_DL_TEMP_FILE" &>/dev/null
  #unset CASJAYSDEV_TITLE_SET && printf '\033]2│;%s\033\\' "${USER}@${HOSTNAME}:${PWD/#$HOME/~} - ${CASJAYSDEV_TITLE_PREV:-$SHELL}"
  if builtin type -t __trap_exit_local | grep -q 'function'; then __trap_exit_local; fi
  return $exitCode
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Install a file with mode 0755, through sudo when the target directory is not writable by this user
__install_file() {
  local src="$1" dest="$2"
  if [ -w "${dest%/*}" ] || { [ ! -e "${dest%/*}" ] && mkdir -p "${dest%/*}" 2>/dev/null; }; then
    install -m 0755 "$src" "$dest"
  elif __user_is_not_root && __can_i_sudo "${RUN_USER:-$USER}"; then
    __sudo mkdir -p "${dest%/*}" && __sudo install -m 0755 "$src" "$dest"
  else
    return 1
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Print the ani-cli to run: ANIME_DL_SOURCE_FILE when it exists, otherwise an ani-cli found in PATH
__find_ani_cli() {
  local found=""
  if [ -x "$ANIME_DL_SOURCE_FILE" ]; then
    printf '%s\n' "$ANIME_DL_SOURCE_FILE"
    return 0
  fi
  found="$(builtin type -P ani-cli 2>/dev/null)"
  [ -n "$found" ] || return 1
  printf '%s\n' "$found"
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Fetch the latest ani-cli release asset into a temp file, check it looks like ani-cli, then install it
__update() {
  local tmp="" dest="$ANIME_DL_SOURCE_FILE"
  printf_green "Updating ani-cli"
  tmp="$(mktemp "$ANIME_DL_TEMP_DIR/ani-cli.XXXXXX" 2>/dev/null)" || {
    printf_red "Failed to create a temp file in $ANIME_DL_TEMP_DIR"
    return 1
  }
  if ! curl -q -LSsf "$ANIME_DL_UPDATE_URL" -o "$tmp" 2>/dev/null; then
    printf_yellow "Failed to download the anime client from:"
    printf_red "$ANIME_DL_UPDATE_URL"
    rm -f "$tmp"
    return 1
  fi
  if ! head -n1 "$tmp" | grep -q -- '^#!' || ! grep -q -- '^version_number=' "$tmp"; then
    printf_red "The downloaded file is not ani-cli, not installing it"
    rm -f "$tmp"
    return 1
  fi
  if ! __install_file "$tmp" "$dest"; then
    dest="$HOME/.local/share/anime-dl/ani-cli"
    printf_yellow "Could not install to ${ANIME_DL_SOURCE_FILE%/*}, using $dest instead"
    __install_file "$tmp" "$dest" || {
      printf_red "Failed to update $APPNAME"
      rm -f "$tmp"
      return 1
    }
    ANIME_DL_SOURCE_FILE="$dest"
  fi
  rm -f "$tmp"
  printf_green "Updated ani-cli to $dest"
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Return 0 when the options ask to watch (-v, -s, -c) instead of download; anime-dl downloads by default
__watch_mode() {
  local opt=""
  for opt in "${ANIME_DL_ARGS[@]}"; do
    case "$opt" in -v | -s | -c) return 0 ;; esac
  done
  return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# ani-cli needs curl, sed, grep and fzf; downloads need yt-dlp or ffmpeg. A missing yt-dlp is installed from its official release.
__check_deps() {
  local tool=""
  for tool in curl sed grep; do
    __cmd_exists "$tool" || { printf_red "$tool is required"; return 1; }
  done
  __cmd_exists fzf || { printf_red "fzf is required for the anime menu, install it with your package manager"; return 1; }
  __watch_mode && return 0
  __cmd_exists yt-dlp ffmpeg && return 0
  __cmd_exists yt-dlp || __cmd_exists ffmpeg || {
    printf_green "Installing yt-dlp"
    __install_yt_dlp || { printf_red "yt-dlp or ffmpeg is required to download"; return 1; }
  }
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Run ani-cli with the parsed options and the query words. ani-cli saves into ANI_CLI_DOWNLOAD_DIR, one folder per query.
__download() {
  local src="$1" && shift 1
  local query="$*" dir="${ANIME_DL_NEW_SAVE_DIR:-$ANIME_DL_SAVE_DIR}" name="" opts=("${ANIME_DL_ARGS[@]}") default_opts=()
  if ! __watch_mode && [[ " ${opts[*]} " != *" -d "* ]]; then
    read -ra default_opts <<<"${ANIME_DL_DEFAULT_OPTS:--d}"
    opts=("${default_opts[@]}" "${opts[@]}")
  fi
  if [ -n "$query" ]; then
    name="${query//[^A-Za-z0-9._-]/_}"
    name="${name#"${name%%[!.]*}"}"
    dir="$dir/${name:-anime}"
  fi
  mkdir -p "$dir" || printf_exit "Failed to create $dir"
  cd "$dir" || printf_exit "Failed to enter $dir"
  printf_cyan "Setting download dir to $dir"
  ANI_CLI_DOWNLOAD_DIR="$dir" "$src" "${opts[@]}" "$@"
  exitCode=$?
  if [ $exitCode -eq 0 ]; then
    [ -n "$query" ] && __notifications "Download of $query has finished" || __notifications
  fi
  return $exitCode
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__execute_ani_cli() {
  local src=""
  __check_deps || return 1
  src="$(__find_ani_cli)" || { __update && src="$(__find_ani_cli)"; } || printf_exit "Could not find or install ani-cli"
  [ $# -eq 0 ] || printf_yellow "Sending $* to: $src"
  __download "$src" "$@"
  exitCode=$?
  echo
  return $exitCode
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Name of the official standalone yt-dlp release asset for this OS, CPU and libc. A musl build only runs on
# musl systems (its loader is /lib/ld-musl-*), so glibc and musl are told apart. Anything else gets the
# platform-independent zipimport build, which needs Python 3.11+.
__yt_dlp_asset() {
  local arch="$(uname -m)" libc="glibc"
  [ "$arch" = "arm64" ] && arch="aarch64"
  case "$(uname -s)" in
  Darwin)
    echo "yt-dlp_macos"
    return 0
    ;;
  Linux) ;;
  *)
    echo "yt-dlp"
    return 0
    ;;
  esac
  if ! getconf GNU_LIBC_VERSION &>/dev/null && compgen -G "/lib/ld-musl-*" >/dev/null; then
    libc="musl"
  fi
  case "$libc-$arch" in
  glibc-x86_64) echo "yt-dlp_linux" ;;
  glibc-aarch64) echo "yt-dlp_linux_aarch64" ;;
  musl-x86_64) echo "yt-dlp_musllinux" ;;
  musl-aarch64) echo "yt-dlp_musllinux_aarch64" ;;
  *) echo "yt-dlp" ;;
  esac
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Directory for installed binaries: ANIME_DL_BIN_DIR if set, /usr/local/bin for root or a user who can sudo, otherwise ~/.local/bin
__bin_dir() {
  if [ -n "$ANIME_DL_BIN_DIR" ]; then
    echo "$ANIME_DL_BIN_DIR"
  elif __user_is_root || __can_i_sudo "${RUN_USER:-$USER}"; then
    echo "/usr/local/bin"
  else
    echo "$HOME/.local/bin"
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Install the official yt-dlp release binary and verify it against the published SHA2-256SUMS
__install_yt_dlp() {
  local base="https://github.com/yt-dlp/yt-dlp/releases/latest/download"
  local dest="$(__bin_dir)/yt-dlp" asset="" tmp="" want="" got=""
  asset="$(__yt_dlp_asset)"
  if [ "$asset" = "yt-dlp" ] && ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' &>/dev/null; then
    printf_red "No standalone yt-dlp build for $(uname -s) $(uname -m) and Python 3.11+ was not found"
    return 1
  fi
  tmp="$(mktemp -d "$ANIME_DL_TEMP_DIR/install.XXXXXX" 2>/dev/null)" || return 1
  if ! curl -q -LSsf "$base/$asset" -o "$tmp/$asset" 2>>"$ANIME_DL_LOG_DIR/install.log" ||
    ! curl -q -LSsf "$base/SHA2-256SUMS" -o "$tmp/SHA2-256SUMS" 2>>"$ANIME_DL_LOG_DIR/install.log"; then
    rm -Rf "$tmp"
    return 1
  fi
  want="$(awk -v a="$asset" '$2 == a {print $1}' "$tmp/SHA2-256SUMS")"
  got="$({ sha256sum "$tmp/$asset" 2>/dev/null || shasum -a 256 "$tmp/$asset" 2>/dev/null; } | awk '{print $1}')"
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    printf_red "Checksum verification failed for $asset"
    rm -Rf "$tmp"
    return 1
  fi
  if ! __install_file "$tmp/$asset" "$dest"; then
    printf_yellow "Could not install to ${dest%/*}, using $HOME/.local/bin instead"
    dest="$HOME/.local/bin/yt-dlp"
    __install_file "$tmp/$asset" "$dest" || { rm -Rf "$tmp"; return 1; }
  fi
  rm -Rf "$tmp"
  export PATH="${dest%/*}:$PATH"
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# User defined variables/import external variables

# - - - - - - - - - - - - - - - - - - - - - - - - -
# Application Folders
ANIME_DL_CONFIG_FILE="${ANIME_DL_CONFIG_FILE:-settings.conf}"
ANIME_DL_CONFIG_DIR="${ANIME_DL_CONFIG_DIR:-$HOME/.config/myscripts/anime-dl}"
ANIME_DL_CONFIG_BACKUP_DIR="${ANIME_DL_CONFIG_BACKUP_DIR:-$HOME/.local/share/myscripts/anime-dl/backups}"
ANIME_DL_LOG_DIR="${ANIME_DL_LOG_DIR:-$HOME/.local/log/anime-dl}"
ANIME_DL_TEMP_DIR="${ANIME_DL_TEMP_DIR:-$HOME/.local/tmp/system_scripts/anime-dl}"
ANIME_DL_CACHE_DIR="${ANIME_DL_CACHE_DIR:-$HOME/.cache/anime-dl}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Color Settings
ANIME_DL_OUTPUT_COLOR_1="${ANIME_DL_OUTPUT_COLOR_1:-33}"
ANIME_DL_OUTPUT_COLOR_2="${ANIME_DL_OUTPUT_COLOR_2:-5}"
ANIME_DL_OUTPUT_COLOR_GOOD="${ANIME_DL_OUTPUT_COLOR_GOOD:-2}"
ANIME_DL_OUTPUT_COLOR_ERROR="${ANIME_DL_OUTPUT_COLOR_ERROR:-1}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Notification Settings
ANIME_DL_NOTIFY_ENABLED="${ANIME_DL_NOTIFY_ENABLED:-yes}"
ANIME_DL_GOOD_NAME="${ANIME_DL_GOOD_NAME:-Great:}"
ANIME_DL_ERROR_NAME="${ANIME_DL_ERROR_NAME:-Error:}"
ANIME_DL_GOOD_MESSAGE="${ANIME_DL_GOOD_MESSAGE:-No errors reported}"
ANIME_DL_ERROR_MESSAGE="${ANIME_DL_ERROR_MESSAGE:-Errors were reported}"
ANIME_DL_NOTIFY_CLIENT_NAME="${ANIME_DL_NOTIFY_CLIENT_NAME:-$APPNAME}"
ANIME_DL_NOTIFY_CLIENT_ICON="${ANIME_DL_NOTIFY_CLIENT_ICON:-notification-new}"
ANIME_DL_NOTIFY_CLIENT_URGENCY="${ANIME_DL_NOTIFY_CLIENT_URGENCY:-normal}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Additional Variables
ANIME_DL_SAVE_DIR="${ANIME_DL_SAVE_DIR:-$HOME/Videos/Anime}"
ANIME_DL_SOURCE_FILE="${ANIME_DL_SOURCE_FILE:-$CASJAYSDEVDIR/sources/ani-cli}"
ANIME_DL_UPDATE_URL="${ANIME_DL_UPDATE_URL:-https://github.com/pystardust/ani-cli/releases/latest/download/ani-cli}"
ANIME_DL_DEFAULT_OPTS="${ANIME_DL_DEFAULT_OPTS:-}"
ANIME_DL_NEW_SAVE_DIR=""
ANIME_DL_BIN_DIR="${ANIME_DL_BIN_DIR:-}"
ANIME_DL_ARGS=()
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Generate config files
[ -f "$ANIME_DL_CONFIG_DIR/$ANIME_DL_CONFIG_FILE" ] || [ "$*" = "--config" ] || INIT_CONFIG="${INIT_CONFIG:-TRUE}" __gen_config ${SETARGS:-$@}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Import config
[ -f "$ANIME_DL_CONFIG_DIR/$ANIME_DL_CONFIG_FILE" ] && . "$ANIME_DL_CONFIG_DIR/$ANIME_DL_CONFIG_FILE"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Ensure Directories exist
[ -d "$ANIME_DL_LOG_DIR" ] || mkdir -p "$ANIME_DL_LOG_DIR" |& __devnull
[ -d "$ANIME_DL_TEMP_DIR" ] || mkdir -p "$ANIME_DL_TEMP_DIR" |& __devnull
[ -d "$ANIME_DL_CACHE_DIR" ] || mkdir -p "$ANIME_DL_CACHE_DIR" |& __devnull
# - - - - - - - - - - - - - - - - - - - - - - - - -
ANIME_DL_TEMP_FILE="${ANIME_DL_TEMP_FILE:-$(mktemp $ANIME_DL_TEMP_DIR/XXXXXX 2>/dev/null)}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Setup trap to remove temp file
trap '__trap_exit' EXIT
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Setup notification function
__notifications() {
  __cmd_exists notifications || return
  [ "$ANIME_DL_NOTIFY_ENABLED" = "yes" ] || return
  [ "$SEND_NOTIFICATION" = "no" ] && return
  (
    export SCRIPT_OPTS="" _DEBUG=""
    export NOTIFY_GOOD_MESSAGE="${NOTIFY_GOOD_MESSAGE:-$ANIME_DL_GOOD_MESSAGE}"
    export NOTIFY_ERROR_MESSAGE="${NOTIFY_ERROR_MESSAGE:-$ANIME_DL_ERROR_MESSAGE}"
    export NOTIFY_CLIENT_ICON="${NOTIFY_CLIENT_ICON:-$ANIME_DL_NOTIFY_CLIENT_ICON}"
    export NOTIFY_CLIENT_NAME="${NOTIFY_CLIENT_NAME:-$ANIME_DL_NOTIFY_CLIENT_NAME}"
    export NOTIFY_CLIENT_URGENCY="${NOTIFY_CLIENT_URGENCY:-$ANIME_DL_NOTIFY_CLIENT_URGENCY}"
    notifications "$@"
  ) |& __devnull &
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Set custom actions

# - - - - - - - - - - - - - - - - - - - - - - - - -
# Argument/Option settings
SETARGS=("$@")
# - - - - - - - - - - - - - - - - - - - - - - - - -
SHORTOPTS="v,s,d,c,f,q:,a:,p:,r:"
SHORTOPTS+=""
# - - - - - - - - - - - - - - - - - - - - - - - - -
LONGOPTS="completions:,config,debug,dir:,help,options,no-color,version,silent"
LONGOPTS+=",update,quality:,episode:,range:,select-nth:,nextep-countdown,dub,skip,rofi,dmenu,no-detach,exit-after-play"
# - - - - - - - - - - - - - - - - - - - - - - - - -
ARRAY=""
ARRAY+=""
# - - - - - - - - - - - - - - - - - - - - - - - - -
LIST=""
LIST+=""
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Setup application options
setopts=$(getopt -o "$SHORTOPTS" --long "$LONGOPTS" -n "$APPNAME" -- "$@" 2>/dev/null)
eval set -- "${setopts[@]}" 2>/dev/null
while :; do
  case "$1" in
  --no-color)
    shift 1
    export SHOW_RAW="true"
    NC=""
    RESET=""
    BLACK=""
    RED=""
    GREEN=""
    YELLOW=""
    BLUE=""
    PURPLE=""
    CYAN=""
    WHITE=""
    ORANGE=""
    LIGHTRED=""
    BG_GREEN=""
    BG_RED=""
    ICON_INFO="[ info ]"
    ICON_GOOD="[ ok ]"
    ICON_WARN="[ warn ]"
    ICON_ERROR="[ error ]"
    ICON_QUESTION="[ ? ]"
    printf_column() { tee | grep '^'; }
    printf_color() { printf '%b' "$1" | tr -d '\t' | sed '/^%b$/d;s,\x1B\[[0-9;]*[a-zA-Z],,g'; }
    ;;
  --debug)
    shift 1
    set -xo pipefail
    export SCRIPT_OPTS="--debug"
    export _DEBUG="on"
    __devnull() { tee || return 1; }
    __devnull2() { "$@" |& tee -p || return 1; }
    ;;
  --completions)
    if [ "$2" = "short" ]; then
      printf '%s\n' "-$SHORTOPTS" | sed 's|"||g;s|:||g;s|,|,-|g' | tr ',' '\n'
    elif [ "$2" = "long" ]; then
      printf '%s\n' "--$LONGOPTS" | sed 's|"||g;s|:||g;s|,|,--|g' | tr ',' '\n'
    elif [ "$2" = "array" ]; then
      printf '%s\n' "$ARRAY" | sed 's|"||g;s|:||g' | tr ',' '\n'
    elif [ "$2" = "list" ]; then
      printf '%s\n' "$LIST" | sed 's|"||g;s|:||g' | tr ',' '\n'
    else
      exit 1
    fi
    shift 2
    exit $?
    ;;
  --options)
    shift 1
    printf_blue "Current options for ${PROG:-$APPNAME}"
    [ -z "$SHORTOPTS" ] || __list_options "Short Options" "-${SHORTOPTS}" ',' '-' 4
    [ -z "$LONGOPTS" ] || __list_options "Long Options" "--${LONGOPTS}" ',' '--' 4
    [ -z "$ARRAY" ] || __list_options "Base Options" "${ARRAY}" ',' '' 4
    [ -z "$LIST" ] || __list_options "LIST Options" "${LIST}" ',' '' 4
    exit $?
    ;;
  --version)
    shift 1
    __version
    exit $?
    ;;
  --help)
    shift 1
    __help
    exit $?
    ;;
  --config)
    shift 1
    __gen_config
    exit $?
    ;;
  --silent)
    shift 1
    ANIME_DL_SILENT="true"
    ;;
  --dir)
    CWD_IS_SET="TRUE"
    ANIME_DL_CWD="$2"
    [ -d "$ANIME_DL_CWD" ] || mkdir -p "$ANIME_DL_CWD" |& __devnull
    shift 2
    ;;
  --update)
    shift 1
    __update
    exit $?
    ;;
  -c | -d | -s | -v | --nextep-countdown)
    ANIME_DL_ARGS+=("${1/--nextep-countdown/-N}")
    shift 1
    ;;
  -f)
    shift 1
    ;;
  -p)
    ANIME_DL_NEW_SAVE_DIR="$2"
    shift 2
    ;;
  -q | --quality)
    ANIME_DL_ARGS+=(-q "$2")
    shift 2
    ;;
  -r | -a | --episode | --range)
    ANIME_DL_ARGS+=(-e "$2")
    shift 2
    ;;
  --select-nth)
    ANIME_DL_ARGS+=(-S "$2")
    shift 2
    ;;
  --dub | --skip | --rofi | --dmenu | --no-detach | --exit-after-play)
    ANIME_DL_ARGS+=("$1")
    shift 1
    ;;
  --)
    shift 1
    break
    ;;
  esac
done
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Set directory from --dir or the current directory
ANIME_DL_CWD="$(realpath "${ANIME_DL_CWD:-$PWD}" 2>/dev/null)"
export ANIME_DL_CWD
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Set actions based on variables

# - - - - - - - - - - - - - - - - - - - - - - - - -
# Check for required applications/Network check
# - - - - - - - - - - - - - - - - - - - - - - - - -
# APP Variables overrides

# - - - - - - - - - - - - - - - - - - - - - - - - -
# Actions based on env
[ -d "$ANIME_DL_SAVE_DIR" ] || mkdir -p "$ANIME_DL_SAVE_DIR"
cd "$ANIME_DL_SAVE_DIR" || printf_exit "Failed to cd into $ANIME_DL_SAVE_DIR"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Execute functions

# - - - - - - - - - - - - - - - - - - - - - - - - -
# Execute commands

# - - - - - - - - - - - - - - - - - - - - - - - - -
# begin main app
__execute_ani_cli "$@"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Set exit code
exitCode="${exitCode:-0}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# End application
# - - - - - - - - - - - - - - - - - - - - - - - - -
# lets exit with code
exit ${exitCode:-0}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# ex: ts=2 sw=2 et filetype=sh
