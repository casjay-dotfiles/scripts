#!/usr/bin/env sh
# shellcheck shell=sh
# - - - - - - - - - - - - - - - - - - - - - - - - -
##@Version           :  202610261214-git
# @@Author           :  Jason Hempstead
# @@Contact          :  jason@casjaysdev.pro
# @@License          :  WTFPL
# @@ReadME           :  append_path --help
# @@Copyright        :  Copyright: (c) 2022 Jason Hempstead, Casjays Developments
# @@Created          :  Thursday, Aug 04, 2022 19:57 EDT
# @@File             :  append_path
# @@Description      :  Add directories to the current shell PATH
# @@Changelog        :  Use POSIX shell syntax and require sourcing to change PATH
# @@TODO             :
# @@Other            :
# @@Resource         :
# @@Terminal App     :  no
# @@sudo/root        :  no
# @@Template         :  sh/system
# - - - - - - - - - - - - - - - - - - - - - - - - -
# - - - - - - - - - - - - - - - - - - - - - - - - -
APPEND_PATH_VERSION="202610261214-git"

__append_path_help() {
  cat <<'HELP'
Usage: . /path/to/append_path
       append_path [options] [directory ...]

Source this file to define append_path in the current shell. The function adds
existing directories to PATH, placing new entries first. Direct execution
cannot change the parent shell's environment.

Options:
  --help, -h       Show this help
  --version        Show the version
  --options        List supported options
  --completions    List completion values
  --silent         Suppress status output (default)
  --verbose        Show status output
HELP
}

append_path() {
  APPEND_PATH_RUN_SILENT="${APPEND_PATH_SILENT:-true}"
  APPEND_PATH_ADDITIONS=""
  APPEND_PATH_STATUS=0
  APPEND_PATH_PARSE_OPTIONS=true

  while [ "$#" -gt 0 ]; do
    if [ "$APPEND_PATH_PARSE_OPTIONS" = "true" ]; then
      case "$1" in
      --help | -h)
        __append_path_help
        return 0
        ;;
      --version)
        printf '%s\n' "$APPEND_PATH_VERSION"
        return 0
        ;;
      --options)
        printf '%s\n' '--help --version --options --completions --silent --verbose'
        return 0
        ;;
      --completions)
        case "${2:-}" in
        short) printf '%s\n' '-h' ;;
        long) printf '%s\n' '--help --version --options --completions --silent --verbose' ;;
        *) printf '%s\n' 'append_path: use --completions short|long' >&2; return 64 ;;
        esac
        return 0
        ;;
      --silent)
        APPEND_PATH_RUN_SILENT=true
        shift
        continue
        ;;
      --verbose)
        APPEND_PATH_RUN_SILENT=false
        shift
        continue
        ;;
      --)
        APPEND_PATH_PARSE_OPTIONS=false
        shift
        continue
        ;;
      -* )
        printf 'append_path: unknown option: %s\n' "$1" >&2
        return 64
        ;;
      esac
    fi

    APPEND_PATH_REQUESTED="$1"
    shift
    case "$APPEND_PATH_REQUESTED" in
    -*) APPEND_PATH_REQUESTED=./$APPEND_PATH_REQUESTED ;;
    esac
    if [ -d "$APPEND_PATH_REQUESTED" ]; then
      APPEND_PATH_RESOLVED=$(CDPATH='' cd -P "$APPEND_PATH_REQUESTED" 2>/dev/null && pwd -P) || {
        APPEND_PATH_STATUS=77
        continue
      }
    elif [ -f "$APPEND_PATH_REQUESTED" ]; then
      case "$APPEND_PATH_REQUESTED" in
      */*)
        APPEND_PATH_DIRECTORY=${APPEND_PATH_REQUESTED%/*}
        [ -n "$APPEND_PATH_DIRECTORY" ] || APPEND_PATH_DIRECTORY=/
        ;;
      *) APPEND_PATH_DIRECTORY=. ;;
      esac
      APPEND_PATH_RESOLVED=$(CDPATH='' cd -P "$APPEND_PATH_DIRECTORY" 2>/dev/null && pwd -P) || {
        APPEND_PATH_STATUS=77
        continue
      }
    else
      if [ "$APPEND_PATH_RUN_SILENT" != "true" ]; then
        printf 'append_path: path does not exist: %s\n' "$APPEND_PATH_REQUESTED" >&2
      fi
      APPEND_PATH_STATUS=66
      continue
    fi

    case ":${PATH-}:$APPEND_PATH_ADDITIONS:" in
    *:"$APPEND_PATH_RESOLVED":*)
      if [ "$APPEND_PATH_RUN_SILENT" != "true" ]; then
        printf 'append_path: already in PATH: %s\n' "$APPEND_PATH_RESOLVED" >&2
      fi
      ;;
    *)
      APPEND_PATH_ADDITIONS="${APPEND_PATH_ADDITIONS:+$APPEND_PATH_ADDITIONS:}$APPEND_PATH_RESOLVED"
      if [ "$APPEND_PATH_RUN_SILENT" != "true" ]; then
        printf 'append_path: adding to PATH: %s\n' "$APPEND_PATH_RESOLVED" >&2
      fi
      ;;
    esac
  done

  if [ -n "$APPEND_PATH_ADDITIONS" ]; then
    PATH="$APPEND_PATH_ADDITIONS${PATH:+:$PATH}"
    export PATH
  elif [ "$APPEND_PATH_RUN_SILENT" != "true" ]; then
    printf '%s\n' 'append_path: no new paths were added' >&2
  fi

  set -- "$APPEND_PATH_STATUS"
  unset APPEND_PATH_ADDITIONS APPEND_PATH_DIRECTORY APPEND_PATH_PARSE_OPTIONS APPEND_PATH_REQUESTED APPEND_PATH_RESOLVED APPEND_PATH_RUN_SILENT APPEND_PATH_STATUS
  return "$1"
}

case "${0##*/}" in
append_path)
  case "${1:-}" in
  --help | -h)
    __append_path_help
    exit 0
    ;;
  --version)
    printf '%s\n' "$APPEND_PATH_VERSION"
    exit 0
    ;;
  --options)
    printf '%s\n' '--help --version --options --completions --silent --verbose'
    exit 0
    ;;
  --completions)
    case "${2:-}" in
    short) printf '%s\n' '-h' ;;
    long) printf '%s\n' '--help --version --options --completions --silent --verbose' ;;
    *) printf '%s\n' 'append_path: use --completions short|long' >&2; exit 64 ;;
    esac
    exit 0
    ;;
  esac
  printf '%s\n' 'append_path must be sourced to change the current shell PATH.' >&2
  printf '%s\n' 'Use: . /path/to/append_path; append_path /path/to/directory' >&2
  exit 64
  ;;
esac
