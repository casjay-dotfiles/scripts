# - - - - - - - - - - - - - - - - - - - - - - - - -
# Send all output to /dev/null
__devnull() {
  local exitCode=0
  tee &>/dev/null || exitCode=1
  return $exitCode
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Send errors to /dev/null
__devnull2() {
  local exitCode=0
  [ -n "$1" ] || return 1
  local cmd="$1" && shift 1
  "$cmd" "$@" 2>/dev/null || exitCode=1
  return $exitCode
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# See if the executable exists
__cmd_exists() {
  local exitCode=0
  [ -n "$1" ] || return 0
  for cmd in "$@"; do
    if builtin command -v "$cmd" &>/dev/null; then
      exitCode=$((exitCode + 0))
    else
      exitCode=$((exitCode + 1))
    fi
  done
  [ $exitCode -eq 0 ] || exitCode=1
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Check for a valid internet connection
__am_i_online() {
  local exitCode=0
  curl -q -LSsfI --max-time 1 --retry 0 "${1:-https://1.1.1.1}" 2>&1 | grep -qi -- 'server:.*cloudflare' || exitCode=4
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# colorization
if [ -n "${NO_COLOR+x}" ] || [ "$SHOW_RAW" = "true" ]; then
  NC=""
  RESET=""
  BLACK=""
  RED=""
  GREEN=""
  YELLOW=""
  BLUE=""
  PURPLE=""
  CYAN=""
  WHITE=""
  ORANGE=""
  LIGHTRED=""
  BG_GREEN=""
  BG_RED=""
  ICON_INFO="[ info ]"
  ICON_GOOD="[ ok ]"
  ICON_WARN="[ warn ]"
  ICON_ERROR="[ error ]"
  ICON_QUESTION="[ ? ]"
  printf_column() { tee | grep -- '^'; }
  printf_color() { printf '%b' "$1" | tr -d '\t' | sed '/^%b$/d;s,\x1B\[[0-9;]*[a-zA-Z],,g'; }
else
  printf_column() { column -t 2>/dev/null; }
  printf_color() { printf "%b" "$(tput setaf "${2:-7}" 2>/dev/null)" "$1" "$(tput sgr0 2>/dev/null)"; }
fi
# - - - - - - - - - - - - - - - - - - - - - - - - -
# printf_* function suite
__printf_newline() { [ -n "$1" ] && printf '%b\n' "${*:-}" || printf '\n'; }
__printf_green() { printf_color "$1\n" 2; }
__printf_red() { printf_color "$1\n" 208; }
__printf_purple() { printf_color "$1\n" 5; }
__printf_yellow() { printf_color "$1\n" 3; }
__printf_blue() { printf_color "$1\n" 33; }
__printf_cyan() { printf_color "$1\n" 6; }
__printf_exit() {
  test -n "$1" && test -z "${1//[0-9]/}" && local color="$1" && shift 1 || local color="208"
  test -n "$1" && test -z "${1//[0-9]/}" && local exitCode="$1" && shift 1 || local exitCode="1"
  printf_color "$*" "$color" 1>&2
  printf '\n'
  exit "$exitCode"
}
__printf_return() {
  test -n "$1" && test -z "${1//[0-9]/}" && local color="$1" && shift 1 || local color="208"
  test -n "$1" && test -z "${1//[0-9]/}" && local exitCode="$1" && shift 1 || local exitCode="1"
  printf_color "$*" "$color" 1>&2
  printf '\n'
  return "$exitCode"
}
__printf_readline() {
  while IFS= read -r _line; do __printf_cyan "$_line"; done
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Additional printf_ colors
__printf_head() { __printf_blue "$1"; }
__printf_opts() { __printf_purple "$1"; }
__printf_line() { __printf_cyan "$1"; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
# output version
__version() { __printf_cyan "$VERSION"; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
# list options
__list_options() {
  local label="$1" opts="$2" sep="$3" repl="$4" color="$5"
  printf_color "$label: " "$color"
  printf '%s\n' "${opts//$sep/ $repl}" | sed 's|:||g'
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# create the config file
__gen_config() {
  local exitCode=0
  if [ "$INIT_CONFIG" != "TRUE" ]; then
    __printf_blue "Generating the config file in"
    __printf_cyan "$SCREEN_NEW_CONFIG_DIR/$SCREEN_NEW_CONFIG_FILE"
  fi
  mkdir -p "$SCREEN_NEW_CONFIG_DIR" "$SCREEN_NEW_CONFIG_BACKUP_DIR" 2>/dev/null
  [ -f "$SCREEN_NEW_CONFIG_DIR/$SCREEN_NEW_CONFIG_FILE" ] &&
    cp -Rf "$SCREEN_NEW_CONFIG_DIR/$SCREEN_NEW_CONFIG_FILE" "$SCREEN_NEW_CONFIG_BACKUP_DIR/$SCREEN_NEW_CONFIG_FILE.$$"
  cat <<EOF >"$SCREEN_NEW_CONFIG_DIR/$SCREEN_NEW_CONFIG_FILE"
# Settings for screen-new

# - - - - - - - - - - - - - - - - - - - - - - - - -
# Color Settings
SCREEN_NEW_OUTPUT_COLOR_1="${SCREEN_NEW_OUTPUT_COLOR_1:-}"
SCREEN_NEW_OUTPUT_COLOR_2="${SCREEN_NEW_OUTPUT_COLOR_2:-}"
SCREEN_NEW_OUTPUT_COLOR_GOOD="${SCREEN_NEW_OUTPUT_COLOR_GOOD:-}"
SCREEN_NEW_OUTPUT_COLOR_ERROR="${SCREEN_NEW_OUTPUT_COLOR_ERROR:-}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Notification Settings
SCREEN_NEW_SYSTEM_NOTIFY_ENABLED="${SCREEN_NEW_SYSTEM_NOTIFY_ENABLED:-}"
SCREEN_NEW_GOOD_NAME="${SCREEN_NEW_GOOD_NAME:-}"
SCREEN_NEW_ERROR_NAME="${SCREEN_NEW_ERROR_NAME:-}"
SCREEN_NEW_GOOD_MESSAGE="${SCREEN_NEW_GOOD_MESSAGE:-}"
SCREEN_NEW_ERROR_MESSAGE="${SCREEN_NEW_ERROR_MESSAGE:-}"
SCREEN_NEW_NOTIFY_CLIENT_NAME="${SCREEN_NEW_NOTIFY_CLIENT_NAME:-}"
SCREEN_NEW_NOTIFY_CLIENT_ICON="${SCREEN_NEW_NOTIFY_CLIENT_ICON:-}"
SCREEN_NEW_NOTIFY_CLIENT_URGENCY="${SCREEN_NEW_NOTIFY_CLIENT_URGENCY:-}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Exec widget intervals (seconds)
SCREEN_NEW_GIT_INTERVAL="${SCREEN_NEW_GIT_INTERVAL:-15}"
SCREEN_NEW_UPTIME_INTERVAL="${SCREEN_NEW_UPTIME_INTERVAL:-15}"
SCREEN_NEW_WEATHER_INTERVAL="${SCREEN_NEW_WEATHER_INTERVAL:-600}"
SCREEN_NEW_WEATHER_SERVER="${SCREEN_NEW_WEATHER_SERVER:-wttr.in}"
SCREEN_NEW_WEATHER_LOCATION="${SCREEN_NEW_WEATHER_LOCATION:-}"

EOF
  if builtin type -t __gen_config_local | grep -q -- 'function'; then __gen_config_local; fi
  if [ -f "$SCREEN_NEW_CONFIG_DIR/$SCREEN_NEW_CONFIG_FILE" ]; then
    [ "$INIT_CONFIG" = "TRUE" ] || __printf_green "Your config file for $APPNAME has been created"
    . "$SCREEN_NEW_CONFIG_DIR/$SCREEN_NEW_CONFIG_FILE"
  else
    __printf_red "Failed to create the config file"
    exitCode=1
  fi
  return $exitCode
}
