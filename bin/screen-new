# - - - - - - - - - - - - - - - - - - - - - - - - -
# Color Settings
SCREEN_NEW_OUTPUT_COLOR_1="${SCREEN_NEW_OUTPUT_COLOR_1:-33}"
SCREEN_NEW_OUTPUT_COLOR_2="${SCREEN_NEW_OUTPUT_COLOR_2:-5}"
SCREEN_NEW_OUTPUT_COLOR_GOOD="${SCREEN_NEW_OUTPUT_COLOR_GOOD:-2}"
SCREEN_NEW_OUTPUT_COLOR_ERROR="${SCREEN_NEW_OUTPUT_COLOR_ERROR:-1}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Notification Settings
SCREEN_NEW_REMOTE_NOTIFY_ENABLED="${SCREEN_NEW_REMOTE_NOTIFY_ENABLED:-yes}"
SCREEN_NEW_REMOTE_NOTIFY_COMMAND="${SCREEN_NEW_REMOTE_NOTIFY_COMMAND:-web-notify telegram}"
SCREEN_NEW_SYSTEM_NOTIFY_ENABLED="${SCREEN_NEW_SYSTEM_NOTIFY_ENABLED:-yes}"
SCREEN_NEW_GOOD_NAME="${SCREEN_NEW_GOOD_NAME:-Great:}"
SCREEN_NEW_ERROR_NAME="${SCREEN_NEW_ERROR_NAME:-Error:}"
SCREEN_NEW_GOOD_MESSAGE="${SCREEN_NEW_GOOD_MESSAGE:-No errors reported}"
SCREEN_NEW_ERROR_MESSAGE="${SCREEN_NEW_ERROR_MESSAGE:-Errors were reported}"
SCREEN_NEW_NOTIFY_CLIENT_NAME="${SCREEN_NEW_NOTIFY_CLIENT_NAME:-$APPNAME}"
SCREEN_NEW_NOTIFY_CLIENT_ICON="${SCREEN_NEW_NOTIFY_CLIENT_ICON:-notification-new}"
SCREEN_NEW_NOTIFY_CLIENT_URGENCY="${SCREEN_NEW_NOTIFY_CLIENT_URGENCY:-normal}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Generate config files
[ -f "$SCREEN_NEW_CONFIG_DIR/$SCREEN_NEW_CONFIG_FILE" ] || [ "$*" = "--config" ] || INIT_CONFIG="${INIT_CONFIG:-TRUE}" __gen_config ${SETARGS:-$@}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Import config
[ -f "$SCREEN_NEW_CONFIG_DIR/$SCREEN_NEW_CONFIG_FILE" ] && . "$SCREEN_NEW_CONFIG_DIR/$SCREEN_NEW_CONFIG_FILE"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Ensure Directories exist
[ -d "$SCREEN_NEW_RUN_DIR" ] || mkdir -p "$SCREEN_NEW_RUN_DIR" |& __devnull
[ -d "$SCREEN_NEW_LOG_DIR" ] || mkdir -p "$SCREEN_NEW_LOG_DIR" |& __devnull
[ -d "$SCREEN_NEW_TEMP_DIR" ] || mkdir -p "$SCREEN_NEW_TEMP_DIR" |& __devnull
[ -d "$SCREEN_NEW_CACHE_DIR" ] || mkdir -p "$SCREEN_NEW_CACHE_DIR" |& __devnull
[ -d "$SCREEN_NEW_SESSION_DIR" ] || mkdir -p "$SCREEN_NEW_SESSION_DIR" |& __devnull
[ -d "$SCREEN_NEW_FILE_CONF" ] || mkdir -p "$SCREEN_NEW_FILE_CONF" |& __devnull
[ -d "$SCREEN_NEW_FILE_WINDOWS" ] || mkdir -p "$SCREEN_NEW_FILE_WINDOWS" |& __devnull
[ -d "$SCREEN_NEW_FILE_CONF_LOCAL" ] || mkdir -p "$SCREEN_NEW_FILE_CONF_LOCAL" |& __devnull
# - - - - - - - - - - - - - - - - - - - - - - - - -
SCREEN_NEW_TEMP_FILE="${SCREEN_NEW_TEMP_FILE:-$(mktemp $SCREEN_NEW_TEMP_DIR/XXXXXX 2>/dev/null)}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Check for required applications
__cmd_exists screen || __printf_exit "screen is not installed"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Argument/Option settings
SETARGS=("$@")
# - - - - - - - - - - - - - - - - - - - - - - - - -
SHORTOPTS="hv"
SHORTOPTS+=""
# - - - - - - - - - - - - - - - - - - - - - - - - -
LONGOPTS="completions:,config,reset,debug,dir:,exec:,help,name:,options,color,no-color,version,silent,force,"
LONGOPTS+=""
# - - - - - - - - - - - - - - - - - - - - - - - - -
ARRAY="a,attach,ls,list,kill,d,detach,edit,switch,sw,rename,mv,clone,copy,status,info,show,update,create"
ARRAY+=",ai,single,shell,dev,go,rust,python,devops,monitoring,database,docker,rpm,node,bun,deno,build,ssh,productivity,test,default"
# - - - - - - - - - - - - - - - - - - - - - - - - -
LIST=""
LIST+=""
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Setup application options
setopts=$(getopt -o "$SHORTOPTS" --long "$LONGOPTS" -n "$APPNAME" -- "$@" 2>/dev/null)
eval set -- "${setopts[@]}" 2>/dev/null
while :; do
  case "$1" in
  --no-color)
    shift 1
    export SHOW_RAW="true"
    NC=""
    RESET=""
    BLACK=""
    RED=""
    GREEN=""
    YELLOW=""
    BLUE=""
    PURPLE=""
    CYAN=""
    WHITE=""
    ORANGE=""
    LIGHTRED=""
    BG_GREEN=""
    BG_RED=""
    ICON_INFO="[ info ]"
    ICON_GOOD="[ ok ]"
    ICON_WARN="[ warn ]"
    ICON_ERROR="[ error ]"
    ICON_QUESTION="[ ? ]"
    printf_column() { tee | grep -- '^'; }
    printf_color() { printf '%b' "$1" | tr -d '\t' | sed '/^%b$/d;s,\x1B\[[0-9;]*[a-zA-Z],,g'; }
    ;;
  --debug)
    shift 1
    set -xo pipefail
    export SCRIPT_OPTS="--debug"
    export _DEBUG="on"
    __devnull() { tee || return 1; }
    __devnull2() { "$@" |& tee -p || return 1; }
    ;;
  --completions)
    if [ "$2" = "short" ]; then
      printf '%s\n' "-$SHORTOPTS" | sed 's|"||g;s|:||g;s|,|,-|g' | tr ',' '\n'
    elif [ "$2" = "long" ]; then
      printf '%s\n' "--$LONGOPTS" | sed 's|"||g;s|:||g;s|,|,--|g' | tr ',' '\n'
    elif [ "$2" = "array" ]; then
      printf '%s\n' "$ARRAY" | sed 's|"||g;s|:||g' | tr ',' '\n'
    elif [ "$2" = "list" ]; then
      printf '%s\n' "$LIST" | sed 's|"||g;s|:||g' | tr ',' '\n'
    else
      exit 1
    fi
    shift 2
    exit $?
    ;;
  --exec)
    case "$2" in
    weather) __exec_weather ;;
    uptime) __exec_uptime ;;
    git) __exec_git ;;
    keybindings) cat "$SCREEN_NEW_CONFIG_DIR/keybindings.txt" 2>/dev/null ;;
    esac
    shift 2
    exit $?
    ;;
  --options)
    shift 1
    __printf_blue "Current options for ${PROG:-$APPNAME}"
    [ -z "$SHORTOPTS" ] || __list_options "Short Options" "-${SHORTOPTS}" ',' '-' 4
    [ -z "$LONGOPTS" ] || __list_options "Long Options" "--${LONGOPTS}" ',' '--' 4
    [ -z "$ARRAY" ] || __list_options "Base Options" "${ARRAY}" ',' '' 4
    [ -z "$LIST" ] || __list_options "LIST Options" "${LIST}" ',' '' 4
    exit $?
    ;;
  -v | --version)
    shift 1
    __version
    exit $?
    ;;
  -h | --help)
    shift 1
    __help
    exit $?
    ;;
  --color)
    shift 1
    unset SHOW_RAW
    ;;
  --config)
    shift 1
    __gen_config
    exit $?
    ;;
  --reset)
    shift 1
    [ -f "$SCREEN_NEW_CONFIG_DIR/$SCREEN_NEW_CONFIG_FILE" ] && rm -Rf "${SCREEN_NEW_CONFIG_DIR:?}/$SCREEN_NEW_CONFIG_FILE"
    __gen_config
    exit $?
    ;;
  --silent)
    shift 1
    SCREEN_NEW_SILENT="true"
    ;;
  --force)
    shift 1
    export FORCE_INSTALL="true"
    SCREEN_NEW_FORCE_INSTALL="true"
    ;;
  --dir)
    CWD_IS_SET="TRUE"
    SCREEN_NEW_CWD="$2"
    [ -d "$SCREEN_NEW_CWD" ] || mkdir -p "$SCREEN_NEW_CWD" |& __devnull
    shift 2
    ;;
  --name)
    SCREEN_NEW_CUSTOM_NAME="$2"
    shift 2
    ;;
  --no-*)
    __options_function_no "$@"
    shift 1
    ;;
  --yes-*)
    __options_function_yes "$@"
    shift 1
    ;;
  --)
    shift 1
    break
    ;;
  esac
done
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Set directory to current working directory (or --dir override)
SCREEN_NEW_CWD="$(realpath "${SCREEN_NEW_CWD:-$PWD}" 2>/dev/null)"
if [ -d "$SCREEN_NEW_CWD" ]; then
  cd "$SCREEN_NEW_CWD"
else
  __printf_exit "$SCREEN_NEW_CWD does not exist"
fi
export SCREEN_NEW_CWD
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Ensure the master template exists (copy from source on first run)
__create_screen_conf() {
  mkdir -p "$SCREEN_NEW_CONFIG_DIR" 2>/dev/null
  if [ ! -f "$SCREEN_NEW_CONFIG_DIR/template" ]; then
    if [ -f "$CASJAYSDEVDIR/templates/screen/new.conf" ]; then
      cp -Rf "$CASJAYSDEVDIR/templates/screen/new.conf" "$SCREEN_NEW_CONFIG_DIR/template" 2>/dev/null
    else
      touch "$SCREEN_NEW_CONFIG_DIR/template" 2>/dev/null
    fi
  fi
  [ -f "$SCREEN_NEW_CONFIG_DIR/template" ]
}
[ -f "$SCREEN_NEW_CONFIG_DIR/template" ] || __create_screen_conf
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Build screen exec arguments
# For binaries: exec screen -c rc -S name cmd args
# For aliases/functions: exec screen -c rc -S name $SHELL -lic 'cmd args'
__screen_exec() {
  local rc="$1" name="$2" cmd="$3" && shift 3
  if __is_shell_construct "$cmd"; then
    local shell_cmd="$cmd"
    if [ $# -gt 0 ]; then
      shell_cmd="$cmd $(printf '%q ' "$@")"
    fi
    exec screen -c "$rc" -S "$name" "${SHELL:-bash}" -lic "$shell_cmd"
  else
    exec screen -c "$rc" -S "$name" "$cmd" "$@"
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Materialize the per-session main conf file for <name> from the template
# Mirrors tmux-new's __tmux_conf - placeholder tokens are replaced in-place
__screen_conf() {
  local name="${1:-${SCREEN_NEW_NAME:-default}}"
  SCREEN_NEW_NAME="$name"
  mkdir -p "$SCREEN_NEW_FILE_CONF" "$SCREEN_NEW_FILE_WINDOWS" "$SCREEN_NEW_FILE_CONF_LOCAL" 2>/dev/null
  [ -f "$SCREEN_NEW_FILE_CONF_LOCAL/$name" ] || : >"$SCREEN_NEW_FILE_CONF_LOCAL/$name"
  if [ -f "$SCREEN_NEW_FILE_CONF/$name" ]; then
    return 0
  fi
  if [ -f "$SCREEN_NEW_CONFIG_DIR/template" ]; then
    __printf_cyan "Creating $SCREEN_NEW_FILE_CONF/$name"
    cp -Rf "$SCREEN_NEW_CONFIG_DIR/template" "$SCREEN_NEW_FILE_CONF/$name"
    sed -i \
      -e "s|SCREEN_NEW_CONF_FILE_MAIN|${SCREEN_NEW_FILE_CONF}/${name}|g" \
      -e "s|SCREEN_NEW_CONF_FILE_WINDOWS|${SCREEN_NEW_FILE_WINDOWS}/${name}|g" \
      -e "s|SCREEN_NEW_CONF_FILE_LOCAL|${SCREEN_NEW_FILE_CONF_LOCAL}/${name}|g" \
      -e "s|SCREEN_NEW_CONF_BUFFERFILE|${SCREEN_NEW_CACHE_DIR}/${name}.buffer|g" \
      "$SCREEN_NEW_FILE_CONF/$name" 2>/dev/null
  else
    __printf_exit "Can not find $SCREEN_NEW_CONFIG_DIR/template"
  fi
  [ -f "$SCREEN_NEW_FILE_CONF/$name" ] && __printf_blue "config file has been created" || __printf_exit "Failed to create config file"
  return $?
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Generate the per-session windows file: screen -t <name> <idx> <cmd>
__create_screen_windows() {
  local name="$1" && shift 1
  if [ ! -f "$SCREEN_NEW_FILE_WINDOWS/$name" ]; then
    local wname="" wcmd="" wnum="0" add_windows=""
    if [ $# -ne 0 ]; then
      for window in "$@"; do
        [ -n "$window" ] || continue
        if [[ "$window" == *":"* ]]; then
          wname="${window%%:*}"
          wcmd="${window#*:}"
          [ -n "$wname" ] || wname="${wnum}"
          [ -n "$wcmd" ] || wcmd="${SHELL:-bash}"
        else
          wname="${window:-$wnum}"
          wcmd="${SHELL:-bash}"
        fi
        add_windows="$(printf '%s\nscreen -t %s %s %s\n' "$add_windows" "$wname" "$wnum" "$wcmd")"
        wnum=$((wnum + 1))
      done
    fi
    __printf_green "Creating screen windows file"
    cat <<EOF >"$SCREEN_NEW_FILE_WINDOWS/$name"
# Window config for $name
$(printf '%s\n' "$add_windows" | grep -v -- '^$')

select 0
EOF
    [ -f "$SCREEN_NEW_FILE_WINDOWS/$name" ] && __printf_blue "screen windows config file has been created" || __printf_exit "Failed to create screen windows config file"
  fi
  return
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Ensure an ad-hoc (single command) session config exists, return its path
__ensure_screenrc() {
  local name="$1" && shift
  __screen_conf "$name" |& __devnull
  [ -f "$SCREEN_NEW_FILE_WINDOWS/$name" ] || printf '%s\n' "# no additional windows (ad-hoc session)" >"$SCREEN_NEW_FILE_WINDOWS/$name"
  printf '%s' "$SCREEN_NEW_FILE_CONF/$name"
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Launch (or attach to) a preset/custom named session
__launch_screen() {
  local name="${1:-${SCREEN_NEW_NAME:-default}}"
  [ -f "$SCREEN_NEW_FILE_CONF/$name" ] || __printf_exit "No config file found for $name"
  [ -f "$SCREEN_NEW_FILE_WINDOWS/$name" ] || __printf_exit "No windows config file found for $name"
  screen -wipe &>/dev/null
  if screen -ls 2>/dev/null | grep -q -- "\.scn-${name}[[:space:]]"; then
    __printf_cyan "Attaching to existing session: scn-$name"
    exec screen -x "scn-$name"
  else
    __printf_cyan "Starting new screen environment for $name"
    cd "$SCREEN_NEW_CWD" 2>/dev/null || true
    exec screen -c "$SCREEN_NEW_FILE_CONF/$name" -S "scn-$name"
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Shared preset launcher - name, then window specs ("name:cmd" ...)
__screen_preset() {
  local preset="$1" && shift
  local name="${SCREEN_NEW_CUSTOM_NAME:-${preset}-${SCREEN_NEW_CWD##*/}}"
  __screen_conf "$name" |& __devnull
  __create_screen_windows "$name" "$@" |& __devnull
  __launch_screen "$name"
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Refresh the master template from source
__update_screen_template() {
  if [ -f "$CASJAYSDEVDIR/templates/screen/new.conf" ]; then
    __printf_cyan "Updating template from source..."
    cp -f "$CASJAYSDEVDIR/templates/screen/new.conf" "$SCREEN_NEW_CONFIG_DIR/template"
    if [ -f "$SCREEN_NEW_CONFIG_DIR/template" ]; then
      __printf_green "Template updated successfully"
      return 0
    else
      __printf_red "Failed to update template"
      return 1
    fi
  else
    __printf_red "Source template not found: $CASJAYSDEVDIR/templates/screen/new.conf"
    return 1
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Refresh every existing session's main conf file from the current template
__update_all_screen_configs() {
  local updated=0 failed=0
  if [ ! -f "$SCREEN_NEW_CONFIG_DIR/template" ]; then
    __printf_red "Template not found. Run 'screen-new update template' first"
    return 1
  fi
  __printf_cyan "Updating all session configs from template..."
  if [ -d "$SCREEN_NEW_FILE_CONF" ]; then
    for config_file in "$SCREEN_NEW_FILE_CONF"/*; do
      [ -f "$config_file" ] || continue
      local session_name="${config_file##*/}"
      __printf_blue "Updating config for session: $session_name"
      if cp -f "$SCREEN_NEW_CONFIG_DIR/template" "$config_file" 2>/dev/null; then
        sed -i \
          -e "s|SCREEN_NEW_CONF_FILE_MAIN|${SCREEN_NEW_FILE_CONF}/${session_name}|g" \
          -e "s|SCREEN_NEW_CONF_FILE_WINDOWS|${SCREEN_NEW_FILE_WINDOWS}/${session_name}|g" \
          -e "s|SCREEN_NEW_CONF_FILE_LOCAL|${SCREEN_NEW_FILE_CONF_LOCAL}/${session_name}|g" \
          -e "s|SCREEN_NEW_CONF_BUFFERFILE|${SCREEN_NEW_CACHE_DIR}/${session_name}.buffer|g" \
          "$config_file"
        __printf_green "Updated: $session_name"
        updated=$((updated + 1))
      else
        __printf_red "Failed: $session_name"
        failed=$((failed + 1))
      fi
    done
  fi
  __printf_cyan "Update complete: $updated updated, $failed failed"
  [ "$failed" -eq 0 ]
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Detach current session (if attached) and attach to the target session
__screen_switch() {
  local target="${1:-}"
  [ -n "$target" ] || { __printf_red "Usage: $APPNAME switch <name>"; return 1; }
  local label="scn-${target}"
  screen -ls 2>/dev/null | grep -q -- "\.${label}[[:space:]]" || { __printf_red "Session '$target' does not exist"; return 1; }
  [ -z "$STY" ] || screen -X detach
  exec screen -x "$label"
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Rename a live session via screen -X sessionname
__screen_rename() {
  local old="${1:-}" new="${2:-}"
  [ -n "$old" ] && [ -n "$new" ] || { __printf_red "Usage: $APPNAME rename <old_name> <new_name>"; return 1; }
  local old_label="scn-${old}" new_label="scn-${new}"
  screen -ls 2>/dev/null | grep -q -- "\.${old_label}[[:space:]]" || { __printf_red "Session '$old' does not exist"; return 1; }
  if screen -S "$old_label" -X sessionname "$new_label"; then
    __printf_green "Session '$old' renamed to '$new'"
  else
    __printf_red "Failed to rename session"
    return 1
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Clone a session's config files only - degraded, does NOT clone live window/pane state
__screen_clone() {
  local source="${1:-}" target="${2:-}"
  [ -n "$source" ] && [ -n "$target" ] || { __printf_red "Usage: $APPNAME clone <source> <target>"; return 1; }
  if [ ! -f "$SCREEN_NEW_FILE_CONF/$source" ] || [ ! -f "$SCREEN_NEW_FILE_WINDOWS/$source" ]; then
    __printf_red "Cannot clone - config files not found for '$source'"
    return 1
  fi
  if [ -f "$SCREEN_NEW_FILE_CONF/$target" ]; then
    __printf_red "Target '$target' config already exists"
    return 1
  fi
  __printf_yellow "Note: clone copies config only - it does NOT clone live window/pane state"
  cp "$SCREEN_NEW_FILE_CONF/$source" "$SCREEN_NEW_FILE_CONF/$target"
  cp "$SCREEN_NEW_FILE_WINDOWS/$source" "$SCREEN_NEW_FILE_WINDOWS/$target"
  sed -i \
    -e "s|${SCREEN_NEW_FILE_CONF}/${source}|${SCREEN_NEW_FILE_CONF}/${target}|g" \
    -e "s|${SCREEN_NEW_FILE_WINDOWS}/${source}|${SCREEN_NEW_FILE_WINDOWS}/${target}|g" \
    -e "s|${SCREEN_NEW_FILE_CONF_LOCAL}/${source}|${SCREEN_NEW_FILE_CONF_LOCAL}/${target}|g" \
    -e "s|${SCREEN_NEW_CACHE_DIR}/${source}.buffer|${SCREEN_NEW_CACHE_DIR}/${target}.buffer|g" \
    "$SCREEN_NEW_FILE_CONF/$target" 2>/dev/null
  [ -f "$SCREEN_NEW_FILE_CONF_LOCAL/$target" ] || : >"$SCREEN_NEW_FILE_CONF_LOCAL/$target"
  __printf_green "Session '$source' cloned to '$target'"
  __launch_screen "$target"
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# List every active screen-new session (preset "scn-" and ad-hoc "sn-")
__screen_status() {
  local sessions
  sessions="$(screen -ls 2>/dev/null | grep -- '\.scn-\|\.sn-' | sed 's/^[[:space:]]*//')"
  if [ -n "$sessions" ]; then
    __printf_blue "Active screen-new sessions:"
    printf '%s\n' "$sessions" | while IFS= read -r line; do
      __printf_green "  $line"
    done
  else
    __printf_yellow "No active screen-new sessions"
    return 1
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Show info for the session this shell is currently attached to
__screen_show() {
  if [ -n "$STY" ]; then
    __printf_blue "Current session: $STY"
    screen -ls 2>/dev/null | grep -- "$STY" | sed 's/^[[:space:]]*//'
  else
    __printf_yellow "Not currently inside a screen session"
    return 1
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Launch a login shell in a screen session
# Session named after directory basename (sn-scripts, sn-tmp, etc.)
# Usage: __screen_shell [directory]
__screen_shell() {
  local dir="${1:-$SCREEN_NEW_CWD}"
  dir="$(realpath "$dir" 2>/dev/null)"
  if [ ! -d "$dir" ]; then
    __printf_exit "$dir: not a directory"
  fi
  local dir_name="${dir##*/}"
  local session_name="sn-${dir_name}"
  local user_shell="${SHELL:-bash}"
  local screenrc="$(__ensure_screenrc "$session_name" "$user_shell" -l)"
  screen -wipe &>/dev/null
  if screen -ls 2>/dev/null | grep -q -- "\\.${session_name}[[:space:]]"; then
    __printf_cyan "Attaching to existing session: $session_name"
    exec screen -x "$session_name"
  else
    cd "$dir"
    exec screen -c "$screenrc" -S "$session_name" "$user_shell" -l
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Write keybindings reference file
__screen_new_keybindings() {
  [ -n "$1" ] || return 1
  cat <<'KEYBINDINGS' >"$1"
screen-new keybindings (tmux-compatible)
========================================
PREFIX = Ctrl+n (default)
PREFIX PREFIX sends literal prefix key to application

Session Control
  PREFIX d           Detach from session
  PREFIX D D         Detach and logout (power detach)
  PREFIX PREFIX      Send literal prefix key to application
  PREFIX :           Enter screen command prompt

Window Management
  PREFIX t           Create a new window (login shell)
  PREFIX c           Create a new window (login shell)
  PREFIX n           Next window
  PREFIX p           Previous window
  PREFIX ,           Rename current window
  PREFIX w           Interactive window list
  PREFIX @           Kill current window
  PREFIX 0-9         Switch to window by number
  PREFIX '           Switch to window by name/number prompt
  Shift+Left         Previous window (no prefix needed)
  Shift+Right        Next window (no prefix needed)

Split / Layout
  PREFIX \           Split vertically (side by side)
  PREFIX /           Split horizontally (top/bottom)
  PREFIX <tab>       Interactive window list (choose window)
  PREFIX x           Remove current region
  PREFIX Q           Remove all regions except current

Region Resize / Focus
  PREFIX h           Resize region smaller
  PREFIX j           Resize region larger
  PREFIX k           Resize region smaller
  PREFIX l           Resize region larger
  PREFIX Left/Right/Up/Down   Focus adjacent region (no resize conflict)
  PREFIX +           Zoom region to full size (one-way, PREFIX Q to undo)

Clipboard / Copy
  PREFIX [           Enter copy/scrollback mode
                     (navigate with arrows, PgUp/PgDn)
                     (press <space> to start selection, <space> again to copy)
  PREFIX ]           Paste from copy buffer
  PREFIX Y           Copy buffer to system clipboard (wl-copy/xclip/pbcopy)
  PREFIX Ctrl+v      Paste from system clipboard (wl-paste/xclip/pbpaste)

Mouse
  PREFIX m           Enable mouse tracking (scroll only)
  PREFIX M           Disable mouse tracking

Misc
  PREFIX `           Send literal backtick / switch to other region
  PREFIX R           Reload this session's config
  PREFIX ?           Show this help
  PREFIX i           Show window info

Process Exit (zombie mode - on error only)
  When a process exits with an error, the window stays open:
  k                  Kill the window
  r                  Restart the process

Known limitations vs tmux-new (GNU Screen has no plugin system):
  No save/restore/apply-state-cmds/boot/cleanup, no resurrect/continuum,
  no pane sync, no join/break pane<->window, no send-to-every-pane,
  no choose-layout, no sidebar, no click/drag/dblclick/rightclick mouse,
  zoom is one-way, clone is config-only, status/show parse 'screen -ls' text.

Press q to exit this help.
KEYBINDINGS
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Helper: list sn-* sessions
__list_sessions() {
  screen -wipe &>/dev/null
  screen -ls 2>/dev/null | grep -- '\.sn-' | sed 's/^[[:space:]]*//'
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Keybindings reference file used by PREFIX ? in templates/screen/new.conf
[ -f "$SCREEN_NEW_CONFIG_DIR/keybindings.txt" ] || __screen_new_keybindings "$SCREEN_NEW_CONFIG_DIR/keybindings.txt"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# begin main app
SCREEN_NEW_SUBCMD="${1:-}"
[ -n "$SCREEN_NEW_SUBCMD" ] && shift 1
case "$SCREEN_NEW_SUBCMD" in
a | attach)
  SCREEN_NEW_CMD="${1:-}"
  if [ -z "$SCREEN_NEW_CMD" ]; then
    __screen_shell
    exit $?
  fi
  shift 1
  SCREEN_NEW_SESSION_NAME="sn-${SCREEN_NEW_CUSTOM_NAME:-${SCREEN_NEW_CMD##*/}}"
  SCREEN_NEW_SCREENRC="$(__ensure_screenrc "$SCREEN_NEW_SESSION_NAME" "$SCREEN_NEW_CMD" "$@")"
  screen -wipe &>/dev/null
  if screen -ls 2>/dev/null | grep -q -- "\\.${SCREEN_NEW_SESSION_NAME}[[:space:]]"; then
    __printf_cyan "Attaching to existing session: $SCREEN_NEW_SESSION_NAME"
    exec screen -x "$SCREEN_NEW_SESSION_NAME"
  else
    __screen_exec "$SCREEN_NEW_SCREENRC" "$SCREEN_NEW_SESSION_NAME" "$SCREEN_NEW_CMD" "$@"
  fi
  ;;
switch | sw)
  __screen_switch "$1"
  exit $?
  ;;
rename | mv)
  __screen_rename "$1" "$2"
  exit $?
  ;;
clone | copy)
  __screen_clone "$1" "$2"
  exit $?
  ;;
status | info)
  __screen_status
  exit $?
  ;;
show)
  __screen_show
  exit $?
  ;;
update)
  case "${1:-all}" in
  template)
    __update_screen_template
    exit $?
    ;;
  sessions)
    __update_all_screen_configs
    exit $?
    ;;
  all | *)
    __update_screen_template && __update_all_screen_configs
    exit $?
    ;;
  esac
  ;;
create)
  shift 1
  if [ $# -lt 1 ]; then
    __printf_red "Usage: $APPNAME create <name> [win1_name:command] [win2_name:command] ..."
    exit 1
  fi
  SCREEN_NEW_CREATE_NAME="$1" && shift 1
  __screen_conf "$SCREEN_NEW_CREATE_NAME" |& __devnull
  __create_screen_windows "$SCREEN_NEW_CREATE_NAME" "$@" |& __devnull
  __launch_screen "$SCREEN_NEW_CREATE_NAME"
  exit $?
  ;;
ai)
  shift 1
  __screen_preset "ai" "${1:-ai:${SHELL:-bash}}" ${2:-} ${3:-} ${4:-} ${5:-} ${6:-} ${7:-} ${8:-} ${9:-}
  exit $?
  ;;
single)
  shift 1
  __screen_preset "single" "${1:-main:${SHELL:-bash}}" ${2:-} ${3:-} ${4:-} ${5:-} ${6:-} ${7:-} ${8:-} ${9:-}
  exit $?
  ;;
shell)
  shift 1
  __screen_preset "shell" "${1:-main:${SHELL:-bash}}" ${2:-} ${3:-} ${4:-} ${5:-} ${6:-} ${7:-} ${8:-} ${9:-}
  exit $?
  ;;
dev)
  shift 1
  __screen_preset "dev" "${1:-dev:${SHELL:-bash}}" "${2:-editor:${SHELL:-bash}}" "${3:-logging:${SHELL:-bash}}" "${4:-server:${SHELL:-bash}}" ${5:-} ${6:-} ${7:-} ${8:-} ${9:-}
  exit $?
  ;;
go)
  shift 1
  __screen_preset "go" "${1:-main:go run .}" "${2:-test:go test ./...}" "${3:-mod:go mod tidy}" "${4:-editor:${SHELL:-bash}}" "${5:-docs:go doc}"
  exit $?
  ;;
rust)
  shift 1
  __screen_preset "rust" "${1:-build:cargo build}" "${2:-run:cargo run}" "${3:-test:cargo test}" "${4:-editor:${SHELL:-bash}}" "${5:-clippy:cargo clippy}" "${6:-fmt:cargo fmt}"
  exit $?
  ;;
python)
  shift 1
  __screen_preset "python" "${1:-main:python main.py}" "${2:-test:python -m pytest}" "${3:-venv:python -m venv venv}" "${4:-editor:${SHELL:-bash}}" "${5:-jupyter:jupyter notebook}"
  exit $?
  ;;
devops)
  shift 1
  __screen_preset "devops" "${1:-kubectl:kubectl get pods}" "${2:-docker:docker ps}" \
    "${3:-terraform:terraform plan}" "${4:-ansible:${SHELL:-bash}}" "${5:-monitoring:htop}" "${6:-logs:journalctl -f}"
  exit $?
  ;;
monitoring)
  shift 1
  __screen_preset "monitoring" "${1:-htop:htop}" "${2:-logs:journalctl -f}" "${3:-docker:docker stats}" "${4:-network:watch ss -tuln}" "${5:-disk:watch df -h}"
  exit $?
  ;;
database)
  shift 1
  __screen_preset "database" "${1:-mysql:mysql -u root}" "${2:-postgres:psql}" "${3:-redis:redis-cli}" "${4:-mongo:mongosh}" "${5:-editor:${SHELL:-bash}}"
  exit $?
  ;;
docker)
  shift 1
  __screen_preset "docker" "${1:-shell:${SHELL:-bash}}" "${2:-mgr:${SHELL:-bash}}" "${3:-devel:${SHELL:-bash}}" \
    "${4:-editor:${SHELL:-bash}}" "${5:-build:${SHELL:-bash}}" "${6:-testing:${SHELL:-bash}}" \
    "${7:-docker:${SHELL:-bash}}" "${8:-logging:${SHELL:-bash}}" "${9:-remote:${SHELL:-bash}}"
  exit $?
  ;;
rpm)
  shift 1
  __screen_preset "rpm" "main:${SHELL:-bash}" "tools:${SHELL:-bash}" "edit:${SHELL:-bash}" \
    "8-arm64:${SHELL:-bash}" "8-amd64:${SHELL:-bash}" "9-arm64:${SHELL:-bash}" \
    "9-amd64:${SHELL:-bash}" "git:${SHELL:-bash}" "logs:${SHELL:-bash}"
  exit $?
  ;;
node)
  shift 1
  __screen_preset "node" "${1:-devel:${SHELL:-bash}}" "${2:-editor:${SHELL:-bash}}" "${3:-client:${SHELL:-bash}}" \
    "${4:-server:${SHELL:-bash}}" "${5:-database:${SHELL:-bash}}" ${6:-} ${7:-} ${8:-} ${9:-}
  exit $?
  ;;
bun)
  shift 1
  __screen_preset "bun" "${1:-devel:${SHELL:-bash}}" "${2:-editor:${SHELL:-bash}}" "${3:-server:${SHELL:-bash}}" "${4:-database:${SHELL:-bash}}" ${5:-} ${6:-} ${7:-} ${8:-} ${9:-}
  exit $?
  ;;
deno)
  shift 1
  __screen_preset "deno" "${1:-devel:${SHELL:-bash}}" "${2:-editor:${SHELL:-bash}}" "${3:-server:${SHELL:-bash}}" "${4:-database:${SHELL:-bash}}" ${5:-} ${6:-} ${7:-} ${8:-} ${9:-}
  exit $?
  ;;
build)
  shift 1
  __screen_preset "build" "${1:-build:${SHELL:-bash}}" "${2:-edit:${SHELL:-bash}}" "${3:-test:${SHELL:-bash}}" "${4:-log:${SHELL:-bash}}" ${5:-} ${6:-} ${7:-} ${8:-} ${9:-}
  exit $?
  ;;
ssh)
  shift 1
  __screen_preset "ssh" "${1:-1:${SHELL:-bash}}" "${2:-2:${SHELL:-bash}}" "${3:-3:${SHELL:-bash}}" \
    "${4:-4:${SHELL:-bash}}" "${5:-5:${SHELL:-bash}}" "${6:-6:${SHELL:-bash}}" "${7:-7:${SHELL:-bash}}"
  exit $?
  ;;
productivity)
  shift 1
  SCREEN_NEW_CUSTOM_NAME="${SCREEN_NEW_CUSTOM_NAME:-productivity}"
  __screen_preset "productivity" "todo:${SHELL:-bash}" "notes:${SHELL:-bash}" "scratchpad:${SHELL:-bash}" \
    "tasks:${SHELL:-bash}" "blog:${SHELL:-bash}" "tools:${SHELL:-bash}" "weather:${SHELL:-bash}"
  exit $?
  ;;
test)
  shift 1
  __screen_preset "test" "${1:-1:${SHELL:-bash}}" "${2:-2:${SHELL:-bash}}" ${3:-} ${4:-} ${5:-} ${6:-} ${7:-} ${8:-} ${9:-}
  exit $?
  ;;
default)
  shift 1
  __screen_preset "default" "${1:-1:${SHELL:-bash}}" "${2:-2:${SHELL:-bash}}" "${3:-3:${SHELL:-bash}}" ${4:-} ${5:-} ${6:-} ${7:-} ${8:-} ${9:-}
  exit $?
  ;;
edit)
  SCREEN_NEW_EDIT_TARGET="${1:-}"
  SCREEN_NEW_EDITOR="${EDITOR:-vi}"
  if [ -n "$SCREEN_NEW_EDIT_TARGET" ]; then
    SCREEN_NEW_EDIT_FILE="$SCREEN_NEW_SESSION_DIR/sn-${SCREEN_NEW_EDIT_TARGET##*/}.conf"
    if [ ! -f "$SCREEN_NEW_EDIT_FILE" ]; then
      __ensure_screenrc "sn-${SCREEN_NEW_EDIT_TARGET##*/}" "$SCREEN_NEW_EDIT_TARGET" >/dev/null
    fi
    exec "$SCREEN_NEW_EDITOR" "$SCREEN_NEW_EDIT_FILE"
  else
    exec "$SCREEN_NEW_EDITOR" "$SCREEN_NEW_CONFIG_DIR/$SCREEN_NEW_CONFIG_FILE"
  fi
  ;;
ls | list)
  SCREEN_NEW_SESSIONS="$(__list_sessions)"
  if [ -n "$SCREEN_NEW_SESSIONS" ]; then
    __printf_head "Active sessions:"
    printf '%s\n' "$SCREEN_NEW_SESSIONS" | while IFS= read -r line; do
      __printf_line "  $line"
    done
  else
    __printf_cyan "No active sessions"
  fi
  ;;
kill)
  SCREEN_NEW_KILL_TARGET="${1:-}"
  if [ "$SCREEN_NEW_KILL_TARGET" = "all" ]; then
    SCREEN_NEW_SESSIONS="$(__list_sessions)"
    if [ -z "$SCREEN_NEW_SESSIONS" ]; then
      __printf_cyan "No active sessions"
    else
      printf '%s\n' "$SCREEN_NEW_SESSIONS" | awk '{print $1}' | while IFS= read -r s; do
        screen -S "$s" -X quit && __printf_green "Killed: $s" || __printf_red "Failed to kill: $s"
      done
    fi
  elif [ -n "$SCREEN_NEW_KILL_TARGET" ]; then
    SCREEN_NEW_SESSION_NAME="sn-${SCREEN_NEW_KILL_TARGET##*/}"
    if screen -ls 2>/dev/null | grep -q -- "\\.${SCREEN_NEW_SESSION_NAME}[[:space:]]"; then
      screen -S "$SCREEN_NEW_SESSION_NAME" -X quit && __printf_green "Killed: $SCREEN_NEW_SESSION_NAME" || __printf_red "Failed to kill: $SCREEN_NEW_SESSION_NAME"
    else
      __printf_red "Session not found: $SCREEN_NEW_SESSION_NAME"
    fi
  else
    SCREEN_NEW_SESSIONS="$(__list_sessions)"
    if [ -n "$SCREEN_NEW_SESSIONS" ]; then
      __printf_head "Active sessions (use '$APPNAME kill <name>' to kill):"
      printf '%s\n' "$SCREEN_NEW_SESSIONS" | while IFS= read -r line; do
        __printf_line "  $line"
      done
    else
      __printf_cyan "No active sessions"
    fi
  fi
  ;;
d | detach)
  SCREEN_NEW_DETACH_TARGET="${1:-}"
  if [ -n "$SCREEN_NEW_DETACH_TARGET" ]; then
    SCREEN_NEW_SESSION_NAME="sn-${SCREEN_NEW_DETACH_TARGET##*/}"
    if screen -ls 2>/dev/null | grep -q -- "\\.${SCREEN_NEW_SESSION_NAME}[[:space:]]"; then
      screen -S "$SCREEN_NEW_SESSION_NAME" -X detach && __printf_green "Detached: $SCREEN_NEW_SESSION_NAME" || __printf_red "Failed to detach: $SCREEN_NEW_SESSION_NAME"
    else
      __printf_red "Session not found: $SCREEN_NEW_SESSION_NAME"
    fi
  else
    SCREEN_NEW_SESSIONS="$(__list_sessions)"
    if [ -n "$SCREEN_NEW_SESSIONS" ]; then
      __printf_head "Active sessions (use '$APPNAME d <name>' to detach):"
      printf '%s\n' "$SCREEN_NEW_SESSIONS" | while IFS= read -r line; do
        __printf_line "  $line"
      done
    else
      __printf_cyan "No active sessions"
    fi
  fi
  ;;
"")
  __screen_shell
  ;;
*)
  if [ -d "$SCREEN_NEW_SUBCMD" ]; then
    __screen_shell "$SCREEN_NEW_SUBCMD"
  fi
  SCREEN_NEW_CMD="$SCREEN_NEW_SUBCMD"
  SCREEN_NEW_SESSION_NAME="sn-${SCREEN_NEW_CUSTOM_NAME:-${SCREEN_NEW_CMD##*/}}"
  SCREEN_NEW_SCREENRC="$(__ensure_screenrc "$SCREEN_NEW_SESSION_NAME" "$SCREEN_NEW_CMD" "$@")"
  screen -wipe &>/dev/null
  if screen -ls 2>/dev/null | grep -q -- "\\.${SCREEN_NEW_SESSION_NAME}[[:space:]]"; then
    __printf_cyan "Attaching to existing session: $SCREEN_NEW_SESSION_NAME"
    exec screen -x "$SCREEN_NEW_SESSION_NAME"
  else
    __screen_exec "$SCREEN_NEW_SCREENRC" "$SCREEN_NEW_SESSION_NAME" "$SCREEN_NEW_CMD" "$@"
  fi
  ;;
esac
exitCode=$?
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Set exit code
exitCode="${exitCode:-0}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# End application
# - - - - - - - - - - - - - - - - - - - - - - - - -
# lets exit with code
exit ${exitCode:-0}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# ex: ts=2 sw=2 et filetype=sh
