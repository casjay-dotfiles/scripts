# - - - - - - - - - - - - - - - - - - - - - - - - -
# Create a --no-* options function
__options_function_no() {
  local options="${1//=*/}"
  local argument="${1//*=/}"
  case "$options" in
  *) echo "${argument:-No argument provided}" && shift ;;
  esac
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Create a --yes-* options function
__options_function_yes() {
  local options="${1//=*/}"
  local argument="${1//*=/}"
  case "$options" in
  *) echo "${argument:-No argument provided}" && shift ;;
  esac
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Check if command is an alias or function (not a binary in PATH)
__is_shell_construct() {
  local cmd_type
  cmd_type="$(type -t "$1" 2>/dev/null)" || return 1
  case "$cmd_type" in
  alias | function) return 0 ;;
  *) return 1 ;;
  esac
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Cache helper - is $SCREEN_NEW_CACHE_DIR/<key> younger than <ttl> seconds
__cache_valid() {
  local key="$1" ttl="${2:-60}"
  local file="$SCREEN_NEW_CACHE_DIR/$key"
  [ -f "$file" ] || return 1
  local mtime
  mtime="$(stat -c %Y "$file" 2>/dev/null || stat -f %m "$file" 2>/dev/null || echo 0)"
  local age=$(($(date +%s) - mtime))
  [ "$age" -lt "$ttl" ]
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# hardstatus widget - git branch/status for the current directory
__exec_git() {
  local topdir
  topdir="$(git rev-parse --show-toplevel 2>/dev/null)" || return 0
  local key="git_$(printf '%s' "$topdir" | tr '/' '_')"
  local ttl="${SCREEN_NEW_GIT_INTERVAL:-15}"
  if __cache_valid "$key" "$ttl"; then
    cat "$SCREEN_NEW_CACHE_DIR/$key" 2>/dev/null
    return 0
  fi
  local branch
  branch="$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null)"
  [ -n "$branch" ] || return 0
  local flags=""
  git diff --quiet 2>/dev/null || flags="${flags}*"
  git diff --cached --quiet 2>/dev/null || flags="${flags}+"
  [ -z "$(git ls-files --others --exclude-standard 2>/dev/null)" ] || flags="${flags}?"
  printf '%s%s' "$branch" "$flags" | tee "$SCREEN_NEW_CACHE_DIR/$key" 2>/dev/null
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# hardstatus widget - system uptime
__exec_uptime() {
  local ttl="${SCREEN_NEW_UPTIME_INTERVAL:-15}"
  if __cache_valid "uptime" "$ttl"; then
    cat "$SCREEN_NEW_CACHE_DIR/uptime" 2>/dev/null
    return 0
  fi
  local secs
  secs="$(awk '{print int($1)}' /proc/uptime 2>/dev/null)"
  [ -n "$secs" ] || return 0
  local d=$((secs / 86400)) h=$(((secs % 86400) / 3600)) m=$(((secs % 3600) / 60))
  local out
  if [ "$d" -gt 0 ]; then
    out="${d}d ${h}h ${m}m"
  elif [ "$h" -gt 0 ]; then
    out="${h}h ${m}m"
  else
    out="${m}m"
  fi
  printf '%s' "$out" | tee "$SCREEN_NEW_CACHE_DIR/uptime" 2>/dev/null
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# hardstatus widget - current weather
__exec_weather() {
  local ttl="${SCREEN_NEW_WEATHER_INTERVAL:-600}"
  if __cache_valid "weather" "$ttl"; then
    cat "$SCREEN_NEW_CACHE_DIR/weather" 2>/dev/null
    return 0
  fi
  __cmd_exists curl || return 0
  local server="${SCREEN_NEW_WEATHER_SERVER:-wttr.in}"
  local location="${SCREEN_NEW_WEATHER_LOCATION:-${MYLOCATION_NAME:-}}"
  local out
  out="$(curl -s -m 2 "https://${server}/${location}?format=%c%t" 2>/dev/null)"
  [ -n "$out" ] || return 0
  printf '%s' "$out" | tee "$SCREEN_NEW_CACHE_DIR/weather" 2>/dev/null
}
