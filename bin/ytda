# - - - - - - - - - - - - - - - - - - - - - - - - -
# check if arg is a builtin option
__is_an_option() { if [[ "$ARRAY" == *"${1:-^}"* ]]; then return 1; else return 0; fi; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Is current user root
__user_is_root() {
  { [ $(id -u) -eq 0 ] || [ $EUID -eq 0 ] || [ "$WHOAMI" = "root" ]; } && return 0 || return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Is current user not root
__user_is_not_root() {
  if { [ $(id -u) -eq 0 ] || [ $EUID -eq 0 ] || [ "$WHOAMI" = "root" ]; }; then return 1; else return 0; fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Check if user is a member of a group that grants sudo
__sudo_group() {
  case " $(id -nG "${1:-$USER}" 2>/dev/null) " in
  *" wheel "* | *" sudo "* | *" admin "*) return 0 ;;
  esac
  return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# # Get sudo password
__sudoask() {
  ask_for_password sudo true && return 0 || return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Run sudo
__sudorun() {
  __sudoif && __cmd_exists sudo && sudo -HE "$@" || { __sudoif && eval "$@"; }
  return $?
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Test if user has access to sudo: passwordless sudo works, or the user is in a sudo group. Never prompts.
__can_i_sudo() {
  __cmd_exists sudo || return 1
  sudo -n true &>/dev/null </dev/null && return 0
  __sudo_group "${1:-$USER}" && return 0
  return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# User can run sudo
__sudoif() {
  __user_is_root && return 0
  __can_i_sudo "${RUN_USER:-$USER}" && return 0
  __user_is_not_root && __sudoask && return 0 || return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Run command as root
requiresudo() {
  if [ "$YTDA_REQUIRE_SUDO" = "yes" ] && [ -z "$YTDA_REQUIRE_SUDO_RUN" ]; then
    export YTDA_REQUIRE_SUDO="no"
    export YTDA_REQUIRE_SUDO_RUN="true"
    __sudo "$@"
    exit $?
  else
    return 0
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Execute sudo
__sudo() {
  CMD="${1:-echo}" && shift 1
  CMD_ARGS="${*:--e "${RUN_USER:-$USER}"}"
  SUDO="$(builtin command -v sudo 2>/dev/null || echo 'eval')"
  [ "${SUDO##*/}" = "sudo" ] && OPTS="--preserve-env=PATH -HE"
  if __sudoif; then
    export PATH="$PATH"
    $SUDO ${OPTS:-} $CMD $CMD_ARGS && true || false
    exitCode=$?
  else
    printf '%s\n' "This requires root to run"
    exitCode=1
  fi
  return ${exitCode:-1}
}
# End of sudo functions
# - - - - - - - - - - - - - - - - - - - - - - - - -
__trap_exit() {
  exitCode=${exitCode:-0}
  [ -f "$YTDA_TEMP_FILE" ] && rm -Rf "$YTDA_TEMP_FILE" &>/dev/null
  if builtin type -t __trap_exit_local | grep -q 'function'; then __trap_exit_local; fi
  return $exitCode
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# User defined functions
__is_url() {
  if echo "$1" | grep -qE '[-A-Za-z0-9\+&@#/%?=~_|!:,.;]*[-A-Za-z0-9\+&@#/%=~_|]\.[-A-Za-z0-9\+&@#/%?=~_|!:,.;]*[-A-Za-z0-9\+&@#/%=~_|]$'; then
    return 0
  else
    return 1
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__check_yt_conf() { [ -f "$1" ] && return 0 || return 1; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
__generate_playlists() {
  local channel="$1"
  local releases="${YTDA_CHANNEL_NAME:-channels}"
  local filename="$YTDA_CONFIG_DIR/$releases/$channel.txt"
  local playlist_url="https://www.youtube.com/user/$channel/$releases"
  local playlists="$("$YTDA_BIN_FILE" -ij --flat-playlist -- "$playlist_url" | jq -r '.url')"
  if [ -n "$playlists" ]; then
    [ -d "$YTDA_CONFIG_DIR/$releases" ] || mkdir -p "$YTDA_CONFIG_DIR/$releases"
    [ -f "$filename" ] || touch "$filename"
    printf_blue "Setting playlist file to $filename"
    for pl in $playlists; do
      if ! grep -qs "$pl" "$filename"; then
        printf_cyan "Adding $pl to playlist file"
        echo "$pl" >>"$filename"
      fi
    done
  else
    printf_red "Failed to get playlists from $playlist_url"
    return 1
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Pick a JavaScript runtime for YouTube's challenges (yt-dlp only enables deno by default). Prints the extra
# yt-dlp argument needed, nothing for deno, and returns 1 when no runtime is installed. Override with YTDA_JS_RUNTIME.
__js_runtime() {
  local runtime="${YTDA_JS_RUNTIME:-}" candidate=""
  if [ -z "$runtime" ]; then
    for candidate in deno node bun qjs; do
      if __cmd_exists "$candidate"; then
        runtime="$candidate"
        break
      fi
    done
  fi
  [ -n "$runtime" ] || return 1
  [ "$runtime" = "qjs" ] && runtime="quickjs"
  [ "$runtime" = "deno" ] || printf '%s' "--js-runtimes $runtime"
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__youtube_dl() {
  local opts="${YTDL_OPTS:-}"
  local retries="${YTDA_RETRY_LIMIT:-15}"
  local sleep="${YTDA_SLEEP_INTERVAL:-5}"
  local max_errors="${YTDA_MAX_ERRORS:-10}"
  local ytbdl_bin="$YTDA_BIN_FILE"
  local js_args="" skip_args=""
  js_args="$(__js_runtime)"
  [ "$max_errors" -gt 0 ] 2>/dev/null && skip_args="--skip-playlist-after-errors $max_errors"
  $ytbdl_bin --restrict-filenames --no-progress --mark-watched --ignore-errors --continue \
    --download-archive "$YTDA_CONFIG_DIR/archive/ytdl.txt" --sleep-interval $sleep --retries $retries $js_args $skip_args "${YTDA_PASS_ARGS[@]}" $opts "$@"
  return $?
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Build the yt-dlp options that strip tags like (Official Video), [4K] or (Live) from the title, and so from file names and tags.
# Only brackets made up entirely of noise words are removed, so (Live Forever) or (Live at Wembley) stay. Disable with
# YTDA_STRIP_TITLE=no; the words come from YTDA_STRIP_WORDS, a regex alternation. Must come before --metadata-from-title.
__strip_args() {
  local words="$YTDA_STRIP_WORDS"
  YTDA_STRIP_ARGS=()
  [ "$YTDA_STRIP_TITLE" = "no" ] && return 0
  YTDA_STRIP_ARGS=(
    --replace-in-metadata title "(?i)\\s*[\\(\\[](?=[^\\)\\]]*\\b(?:$words)\\b)(?:[\\s,&/+-]|\\b(?:$words|(?:19|20)\\d\\d)\\b)+[\\)\\]]" ""
    --replace-in-metadata title "(?i)\\s*[-–|:]\\s*(?:(?:$words)(?:\\s+|\$))+\$" ""
    --replace-in-metadata title "\\s*[-–|:]+\\s*\$" ""
    --replace-in-metadata title "\\s{2,}" " "
  )
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
nightcorea() {
  local config="$YTDA_YOUTUBE_DL_CONF_DIR/nightcorea" opts=""
  local dir="$HOME/Music/Nightcore"
  local filename="%(artist)s - %(title)s.%(ext)s"
  __check_yt_conf "$config" && opts="--config-location $config" || opts="--ignore-config"
  __youtube_dl --audio-format mp3 -o "$dir/$filename" "${YTDA_STRIP_ARGS[@]}" --metadata-from-title "「Nightcore」→ (?P<title>.+)" \
    --add-metadata --embed-thumbnail --extract-audio --audio-quality 320k $opts "$@"
  return $?
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Shared audio converter: __yta_convert <format> [yt-dlp args] <url>
__yta_convert() {
  local format="$1" && shift 1
  local config="$YTDA_YOUTUBE_DL_CONF_DIR/music" opts=""
  local dir="$HOME/Music/ytdl/$YTDA_FOLDER_FORMAT"
  local filename="%(artist)s - %(title)s.%(ext)s"
  __check_yt_conf "$config" && opts="--config-location $config" || opts="--ignore-config"
  __youtube_dl --audio-format "$format" -f "bestaudio/best" -o "$dir/$filename" "${YTDA_STRIP_ARGS[@]}" --metadata-from-title '(?P<artist>.+?) - (?P<title>.+)' \
    --add-metadata --embed-thumbnail --extract-audio --audio-quality 320k $YTDA_AUDIO_CONF $opts "$@"
  return $?
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__yta_aac() { __yta_convert aac "$@"; }
__yta_best() { __yta_convert mp3 "$@"; }
__yta_flac() { __yta_convert flac "$@"; }
__yta_m4a() { __yta_convert m4a "$@"; }
__yta_mp3() { __yta_convert mp3 "$@"; }
__yta_opus() { __yta_convert opus "$@"; }
__yta_vorbis() { __yta_convert vorbis "$@"; }
__yta_wav() { __yta_convert wav "$@"; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
__grab_file() {
  {
    printf '%s\n' "#### Downloading from $2"
    $1 "$2"
    exitStatus=$?
    printf '\n%s\n\n' "#### Downloading finished with exit code: $exitStatus"
  } &>>"$YTDA_YOUTUBE_DL_LOG_FILE"
  printf '\n'
  return $exitStatus
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Download one URL for one pass. The official pass holds back titles tagged Live with --match-filters; the live pass takes only
# those. Sets YTDA_URL_DEFERRED when live titles were held back, and YTDA_FATAL_ERROR for errors that repeat for every URL.
__download_one() {
  local action="$1" url="$2" pass="$3"
  local search_term="" archive_file="" pretty="" list="" message="" file_url="" label="audio" new="" grabbed=1
  local before=0 produced="false"
  YTDA_URL_DEFERRED="false"
  [ "$pass" = "live" ] && label="live audio"
  pretty="${url//*:\/\//}"
  if [[ "$url" == *"list="* ]]; then
    pretty="${pretty//\/*/}"
    list="$(echo "$url" | awk -F 'list=' '{print $2}' | sed 's|?.*||g;s|&.*||g')"
    search_term="$pretty: $list"
    YTDA_FOLDER_FORMAT="%(creator,uploader)s/%(playlist_title)s"
    archive_file="$YTDA_CONFIG_DIR/archive/playlists.txt"
    printf '%b ' "🔻 ${CYAN}Downloading $label from playlist: $list${NC} 🔻 "
    message="Successfully downloaded from $pretty"
  else
    search_term="$url"
    YTDA_FOLDER_FORMAT="%(channel)s"
    archive_file="$YTDA_CONFIG_DIR/archive/audio.txt"
    printf '%b ' "🔻 ${CYAN}Downloading $label from $pretty${NC} 🔻 "
    message="Successfully downloaded $pretty"
  fi
  if __is_url "$url"; then
    file_url="$url"
  else
    file_url="${YTDA_DEFAULT_URL}$url"
  fi
  pretty="${file_url//*:\/\//}"
  pretty="${pretty//\/*/}"
  YTDA_PASS_ARGS=()
  if [ "$YTDA_PREFER_OFFICIAL" != "no" ]; then
    if [ "$pass" = "live" ]; then
      YTDA_PASS_ARGS=(--match-filters "title ~= $YTDA_LIVE_REGEX")
    else
      YTDA_PASS_ARGS=(--match-filters "title !~= $YTDA_LIVE_REGEX")
    fi
  fi
  [ -f "$YTDA_YOUTUBE_DL_LOG_FILE" ] && before="$(wc -l <"$YTDA_YOUTUBE_DL_LOG_FILE")"
  __grab_file "$action" "$file_url" "$message" && grabbed=0
  new="$(tail -n +$((before + 1)) "$YTDA_YOUTUBE_DL_LOG_FILE" 2>/dev/null)"
  __warn_cookies
  [[ "$new" == *"does not pass filter"* ]] && [ "$pass" = "official" ] && YTDA_URL_DEFERRED="true"
  if [ $grabbed -ne 0 ]; then
    __show_error_log "$pretty"
    return 1
  fi
  echo "$new" | grep -qE -- 'Destination:|has already been downloaded|already in target format' && produced="true"
  rm -Rf "$YTDA_YOUTUBE_DL_LOG_FILE"
  if [ "$pass" = "live" ] && [ "$produced" = "false" ]; then
    printf '\n'
    return 0
  fi
  if [ "$YTDA_URL_DEFERRED" = "true" ] && [ "$produced" = "false" ]; then
    printf_yellow "Only live versions found, downloading them after the official ones"
    return 0
  fi
  grep -sqxF -- "$search_term" "$archive_file" || echo "$search_term" >>"$archive_file"
  printf_green "😀 $message 😀 "
  [ "$YTDA_URL_DEFERRED" = "true" ] && printf_yellow "Live versions are held back and downloaded last"
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Download every URL, official versions first. Live titles are held back (see YTDA_LIVE_REGEX) and fetched in a second pass, only
# for the URLs that had some, so a live version never takes the file name of the official one. YTDA_PREFER_OFFICIAL=no disables it.
__download() {
  local exitCode=0 urls="" deferred="" pass="" url=""
  local action="$1" && shift 1
  YTDA_FATAL_ERROR=""
  urls=$(echo "$@" | tr ',' '\n' | tr ' ' '\n' | sed "s|[']||g")
  for pass in official live; do
    if [ "$pass" = "live" ]; then
      [ -n "$deferred" ] || break
      urls="$deferred"
    fi
    for url in $urls; do
      if ! __download_one "$action" "$url" "$pass"; then
        exitCode=$((exitCode + 1))
        if [ "$YTDA_FATAL_ERROR" = "true" ]; then
          printf_yellow "Stopping: the remaining URLs would fail the same way"
          printf '\n'
          break 2
        fi
      fi
      [ "$YTDA_URL_DEFERRED" = "true" ] && deferred+="$url"$'\n'
      printf '\n'
    done
  done
  YTDA_PASS_ARGS=()
  return $exitCode
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Tell the user when YouTube reports the cookie file as expired, even if the download itself succeeded
__warn_cookies() {
  grep -qs -- 'cookies are no longer valid' "$YTDA_YOUTUBE_DL_LOG_FILE" || return 0
  printf_yellow "YouTube says your cookies are no longer valid, they rotate while the browser session stays open"
  printf_yellow "Export them again from a private window (close it right after) to $YTDA_COOKIE_FILE"
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Explain errors that repeat for every URL (bot check, 403, rate limit). Returns 0 when the error is one of those.
__error_hint() {
  local error="$1" hint=""
  echo "$error" | grep -qiE -- 'not a bot|HTTP Error 403|HTTP Error 429|Too Many Requests|rate.?limit' || return 1
  if ! __js_runtime >/dev/null; then
    hint="No JavaScript runtime found: install deno (or node 20+, bun, quickjs), YouTube needs one"
  elif [ ! -f "$YTDA_COOKIE_FILE" ]; then
    hint="Cookie file not found: $YTDA_COOKIE_FILE"
  else
    hint="Cookies may have expired or rotated: re-export them from a private window, and update yt-dlp"
  fi
  printf_yellow "$hint. If it keeps failing, YouTube may be blocking this network."
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__show_error_log() {
  local error=""
  local url="$1"
  if [ -f "$YTDA_YOUTUBE_DL_LOG_FILE" ]; then
    error="$(grep -E -- '^ERROR: ' "$YTDA_YOUTUBE_DL_LOG_FILE" | tail -n1 | sed 's/^ERROR: *//;s/^\[[^]]*\] *//')"
    [ -n "$error" ] || error="$(grep -E -- '^WARNING: ' "$YTDA_YOUTUBE_DL_LOG_FILE" | tail -n1 | sed 's/^WARNING: *//;s/^\[[^]]*\] *//')"
    if [ -n "$error" ]; then
      printf_yellow "Full error is in $YTDA_YOUTUBE_DL_LOG_FILE"
      printf_red "💔 I'm sorry but an error has occurred : ${error:0:200} 💔 "
      __error_hint "$error" && YTDA_FATAL_ERROR="true"
    else
      printf_yellow "💔 I'm sorry but an error has occurred: Full error is in $YTDA_YOUTUBE_DL_LOG_FILE 💔 "
    fi
  else
    printf_red "😿 Failed to download files from $url 😿 "
  fi
  return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__gen_error_message() {
  sed 's|\[.*\]||g;s/[^ ]* //;s|:||g;s|-||g;s|Downloading webpage||g' | tail -n2 | __find_error_message | tr '\n' '|' | awk -F '|' '{print $2" : "$1}' | grep '^' || return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Warn when a cookie file is not in the Netscape format yt-dlp reads, or holds no youtube.com cookies
__check_cookies() {
  local file="$1"
  head -n1 "$file" | grep -qE -- '^# (Netscape )?HTTP Cookie File' || printf_yellow "Cookie file is missing the '# Netscape HTTP Cookie File' header: $file"
  grep -qE -- '(^|[[:space:]])\.?youtube\.com[[:space:]]' "$file" || printf_yellow "Cookie file has no youtube.com cookies: $file"
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Return 0 when the binary runs; the result is cached per path and modification time so --version only runs once
__bin_works() {
  local bin="$1" stamp="$YTDA_CACHE_DIR/bin-ok" key=""
  key="$bin:$(stat -c %Y "$bin" 2>/dev/null || stat -f %m "$bin" 2>/dev/null)"
  [ -f "$stamp" ] && [ "$(<"$stamp")" = "$key" ] && return 0
  "$bin" --version &>/dev/null || return 1
  echo "$key" >"$stamp"
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Fill YTDA_URL from stdin, a file of urls, or the remaining arguments
__collect_urls() {
  YTDA_URL=()
  if [ $# -eq 0 ] && [ -p "/dev/stdin" ]; then
    read -r -d '' -a YTDA_URL </dev/stdin || true
  elif [ -f "$1" ]; then
    read -r -d '' -a YTDA_URL <"$1" || true
  fi
  [ ${#YTDA_URL[@]} -gt 0 ] || [ $# -gt 0 ] || printf_exit "Usage: $APPNAME [command] <url|id|file>"
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Name of the official standalone yt-dlp release asset for this OS, CPU and libc. A musl build only runs on
# musl systems (its loader is /lib/ld-musl-*), so glibc and musl are told apart. Anything else gets the
# platform-independent zipimport build, which needs Python 3.11+.
__yt_dlp_asset() {
  local arch="$(uname -m)" libc="glibc"
  [ "$arch" = "arm64" ] && arch="aarch64"
  case "$(uname -s)" in
  Darwin)
    echo "yt-dlp_macos"
    return 0
    ;;
  Linux) ;;
  *)
    echo "yt-dlp"
    return 0
    ;;
  esac
  if ! getconf GNU_LIBC_VERSION &>/dev/null && compgen -G "/lib/ld-musl-*" >/dev/null; then
    libc="musl"
  fi
  case "$libc-$arch" in
  glibc-x86_64) echo "yt-dlp_linux" ;;
  glibc-aarch64) echo "yt-dlp_linux_aarch64" ;;
  musl-x86_64) echo "yt-dlp_musllinux" ;;
  musl-aarch64) echo "yt-dlp_musllinux_aarch64" ;;
  *) echo "yt-dlp" ;;
  esac
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Directory for installed binaries: YTDA_BIN_DIR if set, /usr/local/bin for root or a user who can sudo, otherwise ~/.local/bin
__bin_dir() {
  if [ -n "$YTDA_BIN_DIR" ]; then
    echo "$YTDA_BIN_DIR"
  elif __user_is_root || __can_i_sudo "${RUN_USER:-$USER}"; then
    echo "/usr/local/bin"
  else
    echo "$HOME/.local/bin"
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Install a file with mode 0755, through sudo when the target directory is not writable by this user
__install_file() {
  local src="$1" dest="$2"
  if [ -w "${dest%/*}" ] || { [ ! -e "${dest%/*}" ] && mkdir -p "${dest%/*}" 2>/dev/null; }; then
    install -m 0755 "$src" "$dest"
  elif __user_is_not_root && __can_i_sudo "${RUN_USER:-$USER}"; then
    __sudo mkdir -p "${dest%/*}" && __sudo install -m 0755 "$src" "$dest"
  else
    return 1
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Install the official yt-dlp release binary and verify it against the published SHA2-256SUMS
__install_yt_dlp() {
  local base="https://github.com/yt-dlp/yt-dlp/releases/latest/download"
  local dest="$(__bin_dir)/yt-dlp" asset="" tmp="" want="" got=""
  asset="$(__yt_dlp_asset)"
  if [ "$asset" = "yt-dlp" ] && ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' &>/dev/null; then
    printf_red "No standalone yt-dlp build for $(uname -s) $(uname -m) and Python 3.11+ was not found"
    return 1
  fi
  tmp="$(mktemp -d "$YTDA_TEMP_DIR/install.XXXXXX" 2>/dev/null)" || return 1
  if ! curl -q -LSsf "$base/$asset" -o "$tmp/$asset" 2>>"$YTDA_YOUTUBE_DL_LOG_FILE" ||
    ! curl -q -LSsf "$base/SHA2-256SUMS" -o "$tmp/SHA2-256SUMS" 2>>"$YTDA_YOUTUBE_DL_LOG_FILE"; then
    rm -Rf "$tmp"
    return 1
  fi
  want="$(awk -v a="$asset" '$2 == a {print $1}' "$tmp/SHA2-256SUMS")"
  got="$({ sha256sum "$tmp/$asset" 2>/dev/null || shasum -a 256 "$tmp/$asset" 2>/dev/null; } | awk '{print $1}')"
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    printf_red "Checksum verification failed for $asset"
    rm -Rf "$tmp"
    return 1
  fi
  if ! __install_file "$tmp/$asset" "$dest"; then
    printf_yellow "Could not install to ${dest%/*}, using $HOME/.local/bin instead"
    dest="$HOME/.local/bin/yt-dlp"
    __install_file "$tmp/$asset" "$dest" || { rm -Rf "$tmp"; return 1; }
  fi
  rm -Rf "$tmp"
  YTDA_BIN_FILE="$dest"
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__init() {
  local bin="$YTDA_BIN_FILE"
  local name="${YTDA_BIN_NAME:-${bin##*/}}"
  printf_yellow "Setting the logfile to: $YTDA_YOUTUBE_DL_LOG_FILE"
  echo "" >"$YTDA_YOUTUBE_DL_LOG_FILE"
  if [ ! -x "$bin" ]; then
    case "$name" in
    yt-dlp)
      printf_green "Installing $name"
      __install_yt_dlp || printf_exit "Failed to install yt-dlp"
      ;;
    youtube-dl)
      printf_exit "youtube-dl is no longer maintained and has no official release binary, install yt-dlp instead"
      ;;
    *)
      printf_exit "Failed to Initialize $APPNAME"
      ;;
    esac
    __gen_config &>/dev/null
    printf_cyan "Installed $name to $YTDA_BIN_FILE"
  fi
  if [ -x "$YTDA_BIN_FILE" ] && ! __bin_works "$YTDA_BIN_FILE"; then
    printf_exit "$YTDA_BIN_FILE is installed but fails to run, check: $YTDA_BIN_FILE --version (remove it and ytda will install the official binary)"
  fi
  [ "$name" = "yt-dlp" ] && __find_error_message() { awk -F '. ' '{print $1}'; }
  [ "$name" = "youtube-dl" ] && __find_error_message() { awk -F ';' '{print $1}'; }
  return 0
}
