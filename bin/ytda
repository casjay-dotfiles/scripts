# APP Variables overrides
[ -n "$OPTS" ] && YTDL_OPTS="$YTDL_OPTS $OPTS"
if [ -f "$YTDA_COOKIE_FILE" ]; then
  YTDL_OPTS="$YTDL_OPTS --cookies $YTDA_COOKIE_FILE"
  __check_cookies "$YTDA_COOKIE_FILE"
elif [ "$YTDA_COOKIE_FILE" != "$YTDA_CONFIG_DIR/cookies.txt" ]; then
  printf_yellow "Cookie file not found: $YTDA_COOKIE_FILE"
fi
[ -z "$YTDA_YOUTUBE_DL_LOG_FILE" ] && YTDA_YOUTUBE_DL_LOG_FILE="$YTDA_LOG_DIR/ytda.$$.log"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Actions based on env
__strip_args
__init "$@"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Execute functions

# - - - - - - - - - - - - - - - - - - - - - - - - -
# Execute commands

# - - - - - - - - - - - - - - - - - - - - - - - - -
# begin main app
case "$1" in
playlist)
  shift 1
  [ -n "$1" ] || printf_exit "Usage: $APPNAME playlist <CHANNEL_ID>"
  __generate_playlists "$1"
  exitCode=$?
  ;;
yta | ytda | nightcore | aac | flac | m4a | mp3 | opus | vorbis | wav)
  case "$1" in
  yta) action="__yta_best" ;;
  ytda) action="__yta_mp3" ;;
  nightcore) action="nightcorea" ;;
  *) action="__yta_$1" ;;
  esac
  shift 1
  __collect_urls "$@"
  __download "$action" "${YTDA_URL[@]:-$@}"
  exitCode=$?
  ;;
*)
  __collect_urls "$@"
  __download __yta_mp3 "${YTDA_URL[@]:-$@}"
  exitCode=$?
  ;;
esac
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Set exit code
exitCode="${exitCode:-0}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# End application
# - - - - - - - - - - - - - - - - - - - - - - - - -
# lets exit with code
exit ${exitCode:-0}
