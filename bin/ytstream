user_install && __options "$@"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Send all output to /dev/null
__devnull() {
  tee &>/dev/null && exitCode=0 || exitCode=1
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -'
# Send errors to /dev/null
__devnull2() {
  [ -n "$1" ] && local cmd="$1" && shift 1 || return 1
  "$cmd" "$@" 2>/dev/null && exitCode=0 || exitCode=1
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -'
# See if the executable exists
__cmd_exists() {
  local exitCode=0
  [ -n "$1" ] || return 0
  for cmd in "$@"; do
    if builtin command -v "$cmd" &>/dev/null; then
      exitCode=$((exitCode + 0))
    else
      exitCode=$((exitCode + 1))
    fi
  done
  [ $exitCode -eq 0 ] || exitCode=3
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Check for a valid internet connection
__am_i_online() {
  local exitCode=0
  curl -q -LSsfI --max-time 2 --retry 1 "${1:-https://1.1.1.1}" 2>&1 | grep -qi 'server:.*cloudflare' || exitCode=4
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# colorization
if [ -n "${NO_COLOR+x}" ] || [ "$SHOW_RAW" = "true" ]; then
  NC=""
  RESET=""
  BLACK=""
  RED=""
  GREEN=""
  YELLOW=""
  BLUE=""
  PURPLE=""
  CYAN=""
  WHITE=""
  ORANGE=""
  LIGHTRED=""
  BG_GREEN=""
  BG_RED=""
  ICON_INFO="[ info ]"
  ICON_GOOD="[ ok ]"
  ICON_WARN="[ warn ]"
  ICON_ERROR="[ error ]"
  ICON_QUESTION="[ ? ]"
  printf_column() { tee | grep '^'; }
  printf_color() { printf '%b' "$1" | tr -d '\t' | sed '/^%b$/d;s,\x1B\[[0-9;]*[a-zA-Z],,g'; }
else
  printf_color() { printf "%b" "$(tput setaf "${2:-7}" 2>/dev/null)" "$1" "$(tput sgr0 2>/dev/null)"; }
fi
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Additional printf_ colors
__printf_head() { printf_blue "$1"; }
__printf_opts() { printf_purple "$1"; }
__printf_line() { printf_cyan "$1"; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
# output version
__version() { printf_cyan "$VERSION"; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
# list options
__list_options() {
  printf_color "$1: " "$5"
  echo -ne "$2" | sed 's|:||g;s/'$3'/ '$4'/g' | tr '\n' ' '
  printf_newline
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# create the config file
__gen_config() {
  local NOTIFY_CLIENT_NAME="$APPNAME"
  if [ "$INIT_CONFIG" != "TRUE" ]; then
    printf_blue "Generating the config file in"
    printf_cyan "$YTSTREAM_CONFIG_DIR/$YTSTREAM_CONFIG_FILE"
  fi
  [ -d "$YTSTREAM_CONFIG_DIR" ] || mkdir -p "$YTSTREAM_CONFIG_DIR"
  [ -d "$YTSTREAM_CONFIG_BACKUP_DIR" ] || mkdir -p "$YTSTREAM_CONFIG_BACKUP_DIR"
  [ -f "$YTSTREAM_CONFIG_DIR/$YTSTREAM_CONFIG_FILE" ] &&
    cp -Rf "$YTSTREAM_CONFIG_DIR/$YTSTREAM_CONFIG_FILE" "$YTSTREAM_CONFIG_BACKUP_DIR/$YTSTREAM_CONFIG_FILE.$$"
  cat <<EOF >"$YTSTREAM_CONFIG_DIR/$YTSTREAM_CONFIG_FILE"
# Settings for ytstream
YTSTREAM_DEFAULT_PLAYER="${YTSTREAM_DEFAULT_PLAYER:-}"
YTSTREAM_DEFAULT_PLAYER_PIPE="${YTSTREAM_DEFAULT_PLAYER_PIPE:-}"
YTSTREAM_DEFAULT_PLAYER_OPTIONS="${YTSTREAM_DEFAULT_PLAYER_OPTIONS:-}"
YTSTREAM_DEFAULT_PLAYER_CONSOLE="${YTSTREAM_DEFAULT_PLAYER_CONSOLE:-}"
YTSTREAM_DEFAULT_PLAYER_FORMAT="${YTSTREAM_DEFAULT_PLAYER_FORMAT:-}"
YTSTREAM_COOKIE_FILE="${YTSTREAM_COOKIE_FILE:-}"
YTSTREAM_JS_RUNTIME="${YTSTREAM_JS_RUNTIME:-}"
YTSTREAM_BIN_DIR="${YTSTREAM_BIN_DIR:-}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Color Settings
YTSTREAM_OUTPUT_COLOR_1="${YTSTREAM_OUTPUT_COLOR_1:-}"
YTSTREAM_OUTPUT_COLOR_2="${YTSTREAM_OUTPUT_COLOR_2:-}"
YTSTREAM_OUTPUT_COLOR_GOOD="${YTSTREAM_OUTPUT_COLOR_GOOD:-}"
YTSTREAM_OUTPUT_COLOR_ERROR="${YTSTREAM_OUTPUT_COLOR_ERROR:-}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Notification Settings
YTSTREAM_NOTIFY_ENABLED="${YTSTREAM_NOTIFY_ENABLED:-}"
YTSTREAM_GOOD_NAME="${YTSTREAM_GOOD_NAME:-}"
YTSTREAM_ERROR_NAME="${YTSTREAM_ERROR_NAME:-}"
YTSTREAM_GOOD_MESSAGE="${YTSTREAM_GOOD_MESSAGE:-}"
YTSTREAM_ERROR_MESSAGE="${YTSTREAM_ERROR_MESSAGE:-}"
YTSTREAM_NOTIFY_CLIENT_NAME="${YTSTREAM_NOTIFY_CLIENT_NAME:-}"
YTSTREAM_NOTIFY_CLIENT_ICON="${YTSTREAM_NOTIFY_CLIENT_ICON:-}"
YTSTREAM_NOTIFY_CLIENT_URGENCY="${YTSTREAM_NOTIFY_CLIENT_URGENCY:-}"

EOF
  if builtin type -t __gen_config_local | grep -q 'function'; then __gen_config_local; fi
  if [ -f "$YTSTREAM_CONFIG_DIR/$YTSTREAM_CONFIG_FILE" ]; then
    [ "$INIT_CONFIG" = "TRUE" ] || printf_green "Your config file for $APPNAME has been created"
    . "$YTSTREAM_CONFIG_DIR/$YTSTREAM_CONFIG_FILE"
    exitCode=0
  else
    printf_red "Failed to create the config file"
    exitCode=1
  fi
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Help function - Align to 50
__help() {
  __printf_head "- - - - - - - - - - - - - - - - - - - - - - - - -"
  __printf_opts "ytstream:  Open youtube video in media player - $VERSION"
  __printf_head "- - - - - - - - - - - - - - - - - - - - - - - - -"
  __printf_line "Usage: ytstream [options] <url|id> [url|id ...]"
  __printf_line "<url|id>                               - Play the video in the media player"
  __printf_line "--dir <path>                           - Sets the working directory"
  __printf_head "- - - - - - - - - - - - - - - - - - - - - - - - -"
  __printf_opts "Other Options"
  __printf_head "- - - - - - - - - - - - - - - - - - - - - - - - -"
  __printf_line "--help                                 - Shows this message"
  __printf_line "--config                               - Generate user config file"
  __printf_line "--version                              - Show script version"
  __printf_line "--options                              - Shows all available options"
  __printf_line "--debug                                - Enables script debugging"
  __printf_line "--no-color                             - Disable ANSI color output"
  __printf_head "- - - - - - - - - - - - - - - - - - - - - - - - -"
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# check if arg is a builtin option
__is_an_option() { if [[ "$ARRAY" == *"${1:-^}"* ]]; then return 1; else return 0; fi; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Is current user root
__user_is_root() {
  { [ $(id -u) -eq 0 ] || [ $EUID -eq 0 ] || [ "$WHOAMI" = "root" ]; } && return 0 || return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Is current user not root
__user_is_not_root() {
  if { [ $(id -u) -eq 0 ] || [ $EUID -eq 0 ] || [ "$WHOAMI" = "root" ]; }; then return 1; else return 0; fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Check if user is a member of a group that grants sudo
__sudo_group() {
  case " $(id -nG "${1:-$USER}" 2>/dev/null) " in
  *" wheel "* | *" sudo "* | *" admin "*) return 0 ;;
  esac
  return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Test if user has access to sudo: passwordless sudo works, or the user is in a sudo group. Never prompts.
__can_i_sudo() {
  __cmd_exists sudo || return 1
  sudo -n true &>/dev/null </dev/null && return 0
  __sudo_group "${1:-$USER}" && return 0
  return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# # Get sudo password
__sudoask() {
  ask_for_password sudo true && return 0 || return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Run sudo
__sudorun() {
  __sudoif && __cmd_exists sudo && sudo -HE "$@" || { __sudoif && eval "$@"; }
  return $?
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# User can run sudo
__sudoif() {
  __user_is_root && return 0
  __can_i_sudo "${RUN_USER:-$USER}" && return 0
  __user_is_not_root && __sudoask && return 0 || return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Run command as root
requiresudo() {
  if [ "$YTSTREAM_REQUIRE_SUDO" = "yes" ] && [ -z "$YTSTREAM_REQUIRE_SUDO_RUN" ]; then
    export YTSTREAM_REQUIRE_SUDO="no"
    export YTSTREAM_REQUIRE_SUDO_RUN="true"
    __sudo "$@"
    exit $?
  else
    return 0
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Execute sudo
__sudo() {
  CMD="${1:-echo}" && shift 1
  CMD_ARGS="${*:--e "${RUN_USER:-$USER}"}"
  SUDO="$(builtin command -v sudo 2>/dev/null || echo 'eval')"
  [ "${SUDO##*/}" = "sudo" ] && OPTS="--preserve-env=PATH -HE"
  if __sudoif; then
    export PATH="$PATH"
    $SUDO ${OPTS:-} $CMD $CMD_ARGS && true || false
    exitCode=$?
  else
    printf '%s\n' "This requires root to run"
    exitCode=1
  fi
  return ${exitCode:-1}
}
# End of sudo functions
# - - - - - - - - - - - - - - - - - - - - - - - - -
__trap_exit() {
  exitCode=${exitCode:-0}
  [ -f "$YTSTREAM_TEMP_FILE" ] && rm -Rf "$YTSTREAM_TEMP_FILE" &>/dev/null
  #unset CASJAYSDEV_TITLE_SET && printf '\033]2│;%s\033\\' "${USER}@${HOSTNAME}:${PWD/#$HOME/~} - ${CASJAYSDEV_TITLE_PREV:-$SHELL}"
  if builtin type -t __trap_exit_local | grep -q 'function'; then __trap_exit_local; fi
  return $exitCode
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Pick the media player: the configured one when it is installed, otherwise the first of mpv, vlc, mplayer and cvlc.
# mpv comes first because it resolves YouTube pages itself through yt-dlp.
__get_player() {
  local player=""
  if [[ -n "$YTSTREAM_DEFAULT_PLAYER" ]] && __cmd_exists "$YTSTREAM_DEFAULT_PLAYER"; then
    return 0
  fi
  YTSTREAM_DEFAULT_PLAYER=""
  YTSTREAM_DEFAULT_PLAYER_CONSOLE=""
  for player in mpv vlc mplayer cvlc; do
    if __cmd_exists "$player"; then
      YTSTREAM_DEFAULT_PLAYER="$player"
      [ "$player" = "cvlc" ] && YTSTREAM_DEFAULT_PLAYER_CONSOLE="true"
      break
    fi
  done
  if [[ -z "$YTSTREAM_DEFAULT_PLAYER" ]]; then
    printf_red "Can not find a media player"
    printf_yellow "Please install mpv, vlc, or mplayer"
    return 1
  fi
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__console_app() {
  [[ -n "$YTSTREAM_DEFAULT_PLAYER_CONSOLE" ]] && [[ "$YTSTREAM_DEFAULT_PLAYER_CONSOLE" != "no" ]]
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Pick a JavaScript runtime for YouTube's challenges (yt-dlp only enables deno by default). Prints the extra
# yt-dlp argument needed, nothing for deno, and returns 1 when no runtime is installed. Override with YTSTREAM_JS_RUNTIME.
__js_runtime() {
  local runtime="${YTSTREAM_JS_RUNTIME:-}" candidate=""
  if [ -z "$runtime" ]; then
    for candidate in deno node bun qjs; do
      if __cmd_exists "$candidate"; then
        runtime="$candidate"
        break
      fi
    done
  fi
  [ -n "$runtime" ] || return 1
  [ "$runtime" = "qjs" ] && runtime="quickjs"
  [ "$runtime" = "deno" ] || printf '%s' "--js-runtimes $runtime"
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Options every yt-dlp call needs: the JavaScript runtime YouTube requires and the cookies file when there is one
__ytdlp_args() {
  local js="" js_args=()
  YTSTREAM_YTDLP_ARGS=()
  js="$(__js_runtime)"
  read -ra js_args <<<"$js"
  YTSTREAM_YTDLP_ARGS+=("${js_args[@]}")
  [ -f "$YTSTREAM_COOKIE_FILE" ] && YTSTREAM_YTDLP_ARGS+=(--cookies "$YTSTREAM_COOKIE_FILE")
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Extra mpv options so its built-in yt-dlp hook gets the same JavaScript runtime, cookies and format
__mpv_args() {
  local js="" raw=""
  local format="${YTSTREAM_DEFAULT_PLAYER_FORMAT:-bestvideo*+bestaudio/best}"
  YTSTREAM_MPV_ARGS=("--ytdl-format=$format")
  js="$(__js_runtime)"
  [ -z "$js" ] || raw+="js-runtimes=${js##* },"
  [ -f "$YTSTREAM_COOKIE_FILE" ] && raw+="cookies=$YTSTREAM_COOKIE_FILE,"
  [ -z "$raw" ] || YTSTREAM_MPV_ARGS+=("--ytdl-raw-options=${raw%,}")
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Print what the player opens for one URL: mpv gets the page URL and resolves it itself, any other player gets a direct stream
__stream_target() {
  local url="$1" video_url="" target=""
  local format="${YTSTREAM_DEFAULT_PLAYER_FORMAT:-best}"
  if [[ "$url" == *"://"* ]]; then
    video_url="$url"
  else
    video_url="https://youtube.com/watch?v=$url"
  fi
  if [ "$YTSTREAM_DEFAULT_PLAYER" = "mpv" ]; then
    printf '%s\n' "$video_url"
    return 0
  fi
  target="$(yt-dlp "${YTSTREAM_YTDLP_ARGS[@]}" --quiet --no-warnings -f "$format" -g "$video_url" 2>"$YTSTREAM_TEMP_FILE" | head -n1)"
  if [[ -z "$target" ]]; then
    { echo "An error has occurred: $url"; cat "$YTSTREAM_TEMP_FILE"; } >>"$YTSTREAM_LOG_DIR/play.log" 2>/dev/null
    return 1
  fi
  printf '%s\n' "$target"
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Play every target one after another and return how many failed
__play_targets() {
  local target="" failed=0 log="$YTSTREAM_LOG_DIR/play.log" extra=()
  [ "$YTSTREAM_DEFAULT_PLAYER" = "mpv" ] && extra=("${YTSTREAM_MPV_ARGS[@]}")
  for target in "$@"; do
    { echo "Playing $target"; date +'%m-%d-%Y at %H:%M'; } >>"$log"
    # shellcheck disable=SC2086
    if ! "$YTSTREAM_DEFAULT_PLAYER" $YTSTREAM_DEFAULT_PLAYER_OPTIONS "${extra[@]}" "$target" &>>"$log"; then
      echo "Failed to play $target" >>"$log"
      failed=$((failed + 1))
    fi
    { date +'%m-%d-%Y at %H:%M'; printf '\n'; } >>"$log"
  done
  return $failed
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Resolve every URL first so errors show right away, then play them; GUI players run in the background
__execute_ytstream() {
  local url="" target="" targets=()
  if [ $# -eq 0 ]; then
    printf_red "No URL was provided"
    exitCode=1
    return 1
  fi
  __get_player || { exitCode=1; return 1; }
  __ytdlp_args
  __mpv_args
  for url in "$@"; do
    if target="$(__stream_target "$url")"; then
      targets+=("$target")
    else
      printf_red "Could not get a stream for $url"
      exitCode=69
    fi
  done
  if [ ${#targets[@]} -eq 0 ]; then
    printf_yellow "Please look in $YTSTREAM_LOG_DIR/play.log"
    return $exitCode
  fi
  if __console_app; then
    __play_targets "${targets[@]}" || { printf_red "Please look in $YTSTREAM_LOG_DIR/play.log"; exitCode=1; }
  else
    __play_targets "${targets[@]}" &
  fi
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Name of the official standalone yt-dlp release asset for this OS, CPU and libc. A musl build only runs on
# musl systems (its loader is /lib/ld-musl-*), so glibc and musl are told apart. Anything else gets the
# platform-independent zipimport build, which needs Python 3.11+.
__yt_dlp_asset() {
  local arch="$(uname -m)" libc="glibc"
  [ "$arch" = "arm64" ] && arch="aarch64"
  case "$(uname -s)" in
  Darwin)
    echo "yt-dlp_macos"
    return 0
    ;;
  Linux) ;;
  *)
    echo "yt-dlp"
    return 0
    ;;
  esac
  if ! getconf GNU_LIBC_VERSION &>/dev/null && compgen -G "/lib/ld-musl-*" >/dev/null; then
    libc="musl"
  fi
  case "$libc-$arch" in
  glibc-x86_64) echo "yt-dlp_linux" ;;
  glibc-aarch64) echo "yt-dlp_linux_aarch64" ;;
  musl-x86_64) echo "yt-dlp_musllinux" ;;
  musl-aarch64) echo "yt-dlp_musllinux_aarch64" ;;
  *) echo "yt-dlp" ;;
  esac
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Directory for installed binaries: YTSTREAM_BIN_DIR if set, /usr/local/bin for root or a user who can sudo, otherwise ~/.local/bin
__bin_dir() {
  if [ -n "$YTSTREAM_BIN_DIR" ]; then
    echo "$YTSTREAM_BIN_DIR"
  elif __user_is_root || __can_i_sudo "${RUN_USER:-$USER}"; then
    echo "/usr/local/bin"
  else
    echo "$HOME/.local/bin"
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Install a file with mode 0755, through sudo when the target directory is not writable by this user
__install_file() {
  local src="$1" dest="$2"
  if [ -w "${dest%/*}" ] || { [ ! -e "${dest%/*}" ] && mkdir -p "${dest%/*}" 2>/dev/null; }; then
    install -m 0755 "$src" "$dest"
  elif __user_is_not_root && __can_i_sudo "${RUN_USER:-$USER}"; then
    __sudo mkdir -p "${dest%/*}" && __sudo install -m 0755 "$src" "$dest"
  else
    return 1
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Install the official yt-dlp release binary and verify it against the published SHA2-256SUMS
__install_yt_dlp() {
  local base="https://github.com/yt-dlp/yt-dlp/releases/latest/download"
  local dest="$(__bin_dir)/yt-dlp" asset="" tmp="" want="" got=""
  asset="$(__yt_dlp_asset)"
  if [ "$asset" = "yt-dlp" ] && ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' &>/dev/null; then
    printf_red "No standalone yt-dlp build for $(uname -s) $(uname -m) and Python 3.11+ was not found"
    return 1
  fi
  tmp="$(mktemp -d "$YTSTREAM_TEMP_DIR/install.XXXXXX" 2>/dev/null)" || return 1
  if ! curl -q -LSsf "$base/$asset" -o "$tmp/$asset" 2>>"$YTSTREAM_LOG_DIR/install.log" ||
    ! curl -q -LSsf "$base/SHA2-256SUMS" -o "$tmp/SHA2-256SUMS" 2>>"$YTSTREAM_LOG_DIR/install.log"; then
    rm -Rf "$tmp"
    return 1
  fi
  want="$(awk -v a="$asset" '$2 == a {print $1}' "$tmp/SHA2-256SUMS")"
  got="$({ sha256sum "$tmp/$asset" 2>/dev/null || shasum -a 256 "$tmp/$asset" 2>/dev/null; } | awk '{print $1}')"
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    printf_red "Checksum verification failed for $asset"
    rm -Rf "$tmp"
    return 1
  fi
  if ! __install_file "$tmp/$asset" "$dest"; then
    printf_yellow "Could not install to ${dest%/*}, using $HOME/.local/bin instead"
    dest="$HOME/.local/bin/yt-dlp"
    __install_file "$tmp/$asset" "$dest" || { rm -Rf "$tmp"; return 1; }
  fi
  rm -Rf "$tmp"
  export PATH="${dest%/*}:$PATH"
  return 0
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# User defined variables/import external variables
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Application Folders
YTSTREAM_CONFIG_FILE="${YTSTREAM_CONFIG_FILE:-settings.conf}"
YTSTREAM_CONFIG_DIR="${YTSTREAM_CONFIG_DIR:-$HOME/.config/myscripts/ytstream}"
YTSTREAM_CONFIG_BACKUP_DIR="${YTSTREAM_CONFIG_BACKUP_DIR:-$HOME/.local/share/myscripts/ytstream/backups}"
YTSTREAM_LOG_DIR="${YTSTREAM_LOG_DIR:-$HOME/.local/log/ytstream}"
YTSTREAM_TEMP_DIR="${YTSTREAM_TEMP_DIR:-$HOME/.local/tmp/system_scripts/ytstream}"
YTSTREAM_CACHE_DIR="${YTSTREAM_CACHE_DIR:-$HOME/.cache/ytstream}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Color Settings
YTSTREAM_OUTPUT_COLOR_1="${YTSTREAM_OUTPUT_COLOR_1:-33}"
YTSTREAM_OUTPUT_COLOR_2="${YTSTREAM_OUTPUT_COLOR_2:-5}"
YTSTREAM_OUTPUT_COLOR_GOOD="${YTSTREAM_OUTPUT_COLOR_GOOD:-2}"
YTSTREAM_OUTPUT_COLOR_ERROR="${YTSTREAM_OUTPUT_COLOR_ERROR:-1}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Notification Settings
YTSTREAM_NOTIFY_ENABLED="${YTSTREAM_NOTIFY_ENABLED:-yes}"
YTSTREAM_GOOD_NAME="${YTSTREAM_GOOD_NAME:-Great:}"
YTSTREAM_ERROR_NAME="${YTSTREAM_ERROR_NAME:-Error:}"
YTSTREAM_GOOD_MESSAGE="${YTSTREAM_GOOD_MESSAGE:-No errors reported}"
YTSTREAM_ERROR_MESSAGE="${YTSTREAM_ERROR_MESSAGE:-Errors were reported}"
YTSTREAM_NOTIFY_CLIENT_NAME="${YTSTREAM_NOTIFY_CLIENT_NAME:-$APPNAME}"
YTSTREAM_NOTIFY_CLIENT_ICON="${YTSTREAM_NOTIFY_CLIENT_ICON:-notification-new}"
YTSTREAM_NOTIFY_CLIENT_URGENCY="${YTSTREAM_NOTIFY_CLIENT_URGENCY:-normal}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Additional Variables
YTSTREAM_DEFAULT_PLAYER="${YTSTREAM_DEFAULT_PLAYER:-}"
YTSTREAM_DEFAULT_PLAYER_PIPE="${YTSTREAM_DEFAULT_PLAYER_PIPE:-}"
YTSTREAM_DEFAULT_PLAYER_OPTIONS="${YTSTREAM_DEFAULT_PLAYER_OPTIONS:-}"
YTSTREAM_DEFAULT_PLAYER_CONSOLE="${YTSTREAM_DEFAULT_PLAYER_CONSOLE:-}"
YTSTREAM_DEFAULT_PLAYER_FORMAT="${YTSTREAM_DEFAULT_PLAYER_FORMAT:-}"
YTSTREAM_COOKIE_FILE="${YTSTREAM_COOKIE_FILE:-$YTSTREAM_CONFIG_DIR/cookies.txt}"
YTSTREAM_JS_RUNTIME="${YTSTREAM_JS_RUNTIME:-}"
YTSTREAM_BIN_DIR="${YTSTREAM_BIN_DIR:-}"
YTSTREAM_YTDLP_ARGS=()
YTSTREAM_MPV_ARGS=()
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Generate config files
[ -f "$YTSTREAM_CONFIG_DIR/$YTSTREAM_CONFIG_FILE" ] || [ "$*" = "--config" ] || INIT_CONFIG="${INIT_CONFIG:-TRUE}" __gen_config ${SETARGS:-$@}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Import config
[ -f "$YTSTREAM_CONFIG_DIR/$YTSTREAM_CONFIG_FILE" ] && . "$YTSTREAM_CONFIG_DIR/$YTSTREAM_CONFIG_FILE"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Ensure Directories exist
[ -d "$YTSTREAM_LOG_DIR" ] || mkdir -p "$YTSTREAM_LOG_DIR" |& __devnull
[ -d "$YTSTREAM_TEMP_DIR" ] || mkdir -p "$YTSTREAM_TEMP_DIR" |& __devnull
[ -d "$YTSTREAM_CACHE_DIR" ] || mkdir -p "$YTSTREAM_CACHE_DIR" |& __devnull
# - - - - - - - - - - - - - - - - - - - - - - - - -
YTSTREAM_TEMP_FILE="${YTSTREAM_TEMP_FILE:-$(mktemp $YTSTREAM_TEMP_DIR/XXXXXX 2>/dev/null)}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Setup trap to remove temp file
trap '__trap_exit' EXIT
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Setup notification function
__notifications() {
  __cmd_exists notifications || return
  [ "$YTSTREAM_NOTIFY_ENABLED" = "yes" ] || return
  [ "$SEND_NOTIFICATION" = "no" ] && return
  (
    export SCRIPT_OPTS="" _DEBUG=""
    export NOTIFY_GOOD_MESSAGE="${NOTIFY_GOOD_MESSAGE:-$YTSTREAM_GOOD_MESSAGE}"
    export NOTIFY_ERROR_MESSAGE="${NOTIFY_ERROR_MESSAGE:-$YTSTREAM_ERROR_MESSAGE}"
    export NOTIFY_CLIENT_ICON="${NOTIFY_CLIENT_ICON:-$YTSTREAM_NOTIFY_CLIENT_ICON}"
    export NOTIFY_CLIENT_NAME="${NOTIFY_CLIENT_NAME:-$YTSTREAM_NOTIFY_CLIENT_NAME}"
    export NOTIFY_CLIENT_URGENCY="${NOTIFY_CLIENT_URGENCY:-$YTSTREAM_NOTIFY_CLIENT_URGENCY}"
    notifications "$@"
  ) |& __devnull &
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Set custom actions

# - - - - - - - - - - - - - - - - - - - - - - - - -
# Argument/Option settings
SETARGS=("$@")
# - - - - - - - - - - - - - - - - - - - - - - - - -
SHORTOPTS=""
SHORTOPTS+=""
# - - - - - - - - - - - - - - - - - - - - - - - - -
LONGOPTS="completions:,config,debug,dir:,help,options,no-color,version,silent"
LONGOPTS+=""
# - - - - - - - - - - - - - - - - - - - - - - - - -
ARRAY=""
ARRAY+=""
# - - - - - - - - - - - - - - - - - - - - - - - - -
LIST=""
LIST+=""
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Setup application options
setopts=$(getopt -o "$SHORTOPTS" --long "$LONGOPTS" -n "$APPNAME" -- "$@" 2>/dev/null)
eval set -- "${setopts[@]}" 2>/dev/null
while :; do
  case "$1" in
  --no-color)
    shift 1
    export SHOW_RAW="true"
    NC=""
    RESET=""
    BLACK=""
    RED=""
    GREEN=""
    YELLOW=""
    BLUE=""
    PURPLE=""
    CYAN=""
    WHITE=""
    ORANGE=""
    LIGHTRED=""
    BG_GREEN=""
    BG_RED=""
    ICON_INFO="[ info ]"
    ICON_GOOD="[ ok ]"
    ICON_WARN="[ warn ]"
    ICON_ERROR="[ error ]"
    ICON_QUESTION="[ ? ]"
    printf_column() { tee | grep '^'; }
    printf_color() { printf '%b' "$1" | tr -d '\t' | sed '/^%b$/d;s,\x1B\[[0-9;]*[a-zA-Z],,g'; }
    ;;
  --debug)
    shift 1
    set -xo pipefail
    export SCRIPT_OPTS="--debug"
    export _DEBUG="on"
    __devnull() { tee || return 1; }
    __devnull2() { "$@" |& tee -p || return 1; }
    ;;
  --completions)
    if [ "$2" = "short" ]; then
      printf '%s\n' "-$SHORTOPTS" | sed 's|"||g;s|:||g;s|,|,-|g' | tr ',' '\n'
    elif [ "$2" = "long" ]; then
      printf '%s\n' "--$LONGOPTS" | sed 's|"||g;s|:||g;s|,|,--|g' | tr ',' '\n'
    elif [ "$2" = "array" ]; then
      printf '%s\n' "$ARRAY" | sed 's|"||g;s|:||g' | tr ',' '\n'
    elif [ "$2" = "list" ]; then
      printf '%s\n' "$LIST" | sed 's|"||g;s|:||g' | tr ',' '\n'
    else
      exit 1
    fi
    shift 2
    exit $?
    ;;
  --options)
    shift 1
    printf_blue "Current options for ${PROG:-$APPNAME}"
    [ -z "$SHORTOPTS" ] || __list_options "Short Options" "-${SHORTOPTS}" ',' '-' 4
    [ -z "$LONGOPTS" ] || __list_options "Long Options" "--${LONGOPTS}" ',' '--' 4
    [ -z "$ARRAY" ] || __list_options "Base Options" "${ARRAY}" ',' '' 4
    [ -z "$LIST" ] || __list_options "LIST Options" "${LIST}" ',' '' 4
    exit $?
    ;;
  --version)
    shift 1
    __version
    exit $?
    ;;
  --help)
    shift 1
    __help
    exit $?
    ;;
  --config)
    shift 1
    __gen_config
    exit $?
    ;;
  --silent)
    shift 1
    YTSTREAM_SILENT="true"
    ;;
  --dir)
    CWD_IS_SET="TRUE"
    YTSTREAM_CWD="$2"
    [ -d "$YTSTREAM_CWD" ] || mkdir -p "$YTSTREAM_CWD" |& __devnull
    shift 2
    ;;
  --)
    shift 1
    break
    ;;
  esac
done
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Set directory from --dir or the current directory
YTSTREAM_CWD="$(realpath "${YTSTREAM_CWD:-$PWD}" 2>/dev/null)"
export YTSTREAM_CWD
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Set actions based on variables

# - - - - - - - - - - - - - - - - - - - - - - - - -
# Check for required applications/Network check
# - - - - - - - - - - - - - - - - - - - - - - - - -
# APP Variables overrides

# - - - - - - - - - - - - - - - - - - - - - - - - -
# Actions based on env
__cmd_exists yt-dlp || { printf_green "Installing yt-dlp" && __install_yt_dlp; } || printf_exit "Failed to install yt-dlp" 1
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Execute functions

# - - - - - - - - - - - - - - - - - - - - - - - - -
# Execute commands

# - - - - - - - - - - - - - - - - - - - - - - - - -
# begin main app
__execute_ytstream "$@"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Set exit code
exitCode="${exitCode:-0}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# End application
# - - - - - - - - - - - - - - - - - - - - - - - - -
# lets exit with code
exit ${exitCode:-0}
