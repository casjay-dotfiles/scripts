[ "$1" = "launch-zellij" ] && shift 1
[ -L "$HOME/.zellij.conf" ] && unlink "$HOME/.zellij.conf"
mkdir -p "$ZELLIJ_CONFIG_DIR" "$ZELLIJ_NEW_FILE_CONF" "$ZELLIJ_NEW_FILE_WINDOWS" "$ZELLIJ_NEW_FILE_CONF_LOCAL" 2>/dev/null
[ -e "$HOME/.zellij.conf" ] && [ -f "$ZELLIJ_CONFIG_DIR/zellij.conf" ] && rm -R "$HOME/.zellij.conf"
[ -f "$ZELLIJ_CONFIG_DIR/zellij.conf" ] || __zellij_install_conf "$CASJAYSDEVDIR/templates/zellij/default.conf" "$ZELLIJ_CONFIG_DIR/zellij.conf"
