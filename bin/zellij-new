# - - - - - - - - - - - - - - - - - - - - - - - - -
# check if arg is a builtin option
__is_an_option() { if [[ "$ARRAY" == *"${1:-^}"* ]]; then return 1; else return 0; fi; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
__trap_exit() {
  exitCode=${exitCode:-0}
  [ -f "$ZELLIJ_NEW_TEMP_FILE" ] && rm -Rf "$ZELLIJ_NEW_TEMP_FILE" &>/dev/null
  if builtin type -t __trap_exit_local | grep -q -- 'function'; then __trap_exit_local; fi
  return $exitCode
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__sleep() { sleep "${1:-1}"; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Cache helper function
__cache_valid() {
  local cache_file="$1"
  local cache_ttl="$2"
  local current_time cache_time time_diff
  if [ -f "$cache_file" ]; then
    current_time=$(date +%s)
    cache_time=$(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null || echo 0)
    time_diff=$((current_time - cache_time))
    if [ "$time_diff" -lt "$cache_ttl" ]; then
      return 0
    fi
  fi
  return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Weather function with caching
__exec_weather() {
  local cache_dir="${ZELLIJ_CACHE_DIR:-$HOME/.cache/zellij}"
  local cache_file="$cache_dir/weather"
  local cache_ttl="${ZELLIJ_WEATHER_INTERVAL:-3600}"
  local weather_server="${ZELLIJ_WEATHER_SERVER:-https://wthr.top}"
  local weather_location="${MYLOCATION_NAME:-${ZELLIJ_WEATHER_LOCATION:-New York, NY}}"
  local weather_url
  weather_url="${weather_location// /%20}"
  [ -d "$cache_dir" ] || mkdir -p "$cache_dir" 2>/dev/null
  if __cache_valid "$cache_file" "$cache_ttl"; then
    cat "$cache_file" 2>/dev/null || echo "No Weather"
  else
    local weather
    weather=$(curl -q -LSsf -m 2 "${weather_server}/${weather_url}?u&format=3" 2>/dev/null | sed 's/:/ /g;s/°F/F/g' || echo "No Weather")
    echo "$weather" >"$cache_file" 2>/dev/null
    echo "$weather"
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Uptime function with caching
__exec_uptime() {
  local cache_dir="${ZELLIJ_CACHE_DIR:-$HOME/.cache/zellij}"
  local cache_file="$cache_dir/uptime"
  local cache_ttl="${ZELLIJ_UPTIME_INTERVAL:-60}"
  [ -d "$cache_dir" ] || mkdir -p "$cache_dir" 2>/dev/null
  if __cache_valid "$cache_file" "$cache_ttl"; then
    cat "$cache_file" 2>/dev/null
  else
    local uptime_info
    uptime_info=$(uptime | cut -f 4-5 -d ' ' | cut -f 1 -d ',' 2>/dev/null)
    echo "$uptime_info" >"$cache_file" 2>/dev/null
    echo "$uptime_info"
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__init() {
  local name="$1"
  name="${name##*/}"
  if [ -f "$ZELLIJ_NEW_FILE_LAYOUTS/$name.kdl" ]; then
    ZELLIJ_NEW_NAME="$name"
  elif [ -f "$ZELLIJ_NEW_FILE_LAYOUTS/$name-$name.kdl" ]; then
    ZELLIJ_NEW_NAME="$name-$name"
  elif [ -f "$ZELLIJ_NEW_FILE_LAYOUTS/$USER-$name.kdl" ]; then
    ZELLIJ_NEW_NAME="$USER-$name"
  elif [ -f "$ZELLIJ_NEW_FILE_LAYOUTS/$name-$USER.kdl" ]; then
    ZELLIJ_NEW_NAME="$name-$USER"
  else
    ZELLIJ_NEW_NAME="$name"
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Resolve the OS clipboard tool, mirroring templates/tmux/new.conf's
# xclip/wl-copy/pbcopy if-shell runtime detection. Empty output means fall
# back to zellij's built-in OSC-52 clipboard.
__zellij_copy_command() {
  if __cmd_exists xclip; then
    printf '%s' "xclip -selection clipboard"
  elif __cmd_exists wl-copy; then
    printf '%s' "wl-copy"
  elif __cmd_exists pbcopy; then
    printf '%s' "pbcopy"
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Install a shipped .conf template, substituting the ZELLIJ_NEW_COPY_COMMAND
# placeholder with the detected clipboard tool, or dropping the copy_command
# line entirely when no tool is found so the OSC-52 fallback applies
__zellij_install_conf() {
  local src="$1" dest="$2" copy_cmd
  [ -f "$src" ] || return 1
  copy_cmd="$(__zellij_copy_command)"
  mkdir -p "${dest%/*}" 2>/dev/null
  if [ -n "$copy_cmd" ]; then
    sed "s|ZELLIJ_NEW_COPY_COMMAND|$copy_cmd|g" "$src" >"$dest"
  else
    sed '/copy_command "ZELLIJ_NEW_COPY_COMMAND"/d' "$src" >"$dest"
  fi
  [ -f "$dest" ]
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Install a shipped per-preset KDL layout, substituting the ZELLIJ_NEW_CWD
# placeholder with the resolved session working directory
__zellij_install_layout() {
  local preset="$1" name="$2" src="$CASJAYSDEVDIR/templates/zellij/layouts/$preset.kdl"
  [ -f "$src" ] || src="$CASJAYSDEVDIR/templates/zellij/layouts/default.kdl"
  [ -f "$src" ] || return 1
  mkdir -p "$ZELLIJ_NEW_FILE_LAYOUTS" 2>/dev/null
  sed "s|ZELLIJ_NEW_CWD|$ZELLIJ_NEW_CWD|g" "$src" >"$ZELLIJ_NEW_FILE_LAYOUTS/$name.kdl"
  [ -s "$ZELLIJ_NEW_FILE_LAYOUTS/$name.kdl" ]
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Kill every zellij session - native equivalent of tmux-new's kill-all. No
# recreate-after-kill: zellij has no way to query a non-attached session's
# cwd remotely, so the old custom recreate mechanism was not portable and
# has been dropped rather than faked (confirmed: `zellij list-sessions`
# has no path-reporting `-F`/format flag).
__zellij_kill_all() {
  local exitCode=0
  if ! __zellij_get_all_sessions >/dev/null 2>&1; then
    __printf_yellow "No active sessions to kill"
    return 0
  fi
  __printf_cyan "Killing all zellij sessions..."
  zellij delete-all-sessions --force --yes
  exitCode=$?
  if [ $exitCode -eq 0 ]; then
    __printf_green "All sessions killed"
  else
    __printf_red "Failed to kill all sessions"
  fi
  return $exitCode
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__zellij_kill() {
  local exitCode=0
  local session="$(zellij list-sessions 2>/dev/null)"
  case "$1" in
  all)
    shift 1
    __zellij_kill_all
    return $?
    ;;
  session)
    shift
    [ $# -ne 0 ] || __printf_cyan "Usage: $APPNAME kill session [name]"
    for arg in "$@"; do
      local retVal=0
      exists="$(echo "$session" | grep -- "^$arg" || echo '')"
      if [ -n "$exists" ]; then
        __printf_cyan "Killing session $arg"
        zellij delete-session --force "$arg" &>/dev/null
        retVal=$?
        exitCode=$((exitCode + retVal))
      else
        __printf_yellow "The session $arg does not exist"
      fi
    done
    return $exitCode
    ;;
  *)
    __printf_cyan "Usage: $APPNAME kill [all|session] [name]"
    __printf_cyan "Note: Zellij does not support killing individual tabs/panes from CLI"
    if [ -n "$session" ]; then
      printf '%s\n' "$session"
    fi
    exitCode=$?
    return $exitCode
    ;;
  esac
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__cd() {
  ZELLIJ_NEW_CWD="${1:-$ZELLIJ_NEW_CWD}"
  mkdir -p "$ZELLIJ_NEW_CWD" 2>/dev/null
  builtin cd "$ZELLIJ_NEW_CWD" || return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__zellij_get_all_sessions() {
  local all_sessions=""
  all_sessions="$(zellij list-sessions -s -n 2>/dev/null | grep -v -- '^$' || true)"
  if [ -n "$all_sessions" ]; then
    printf '%s\n' "$all_sessions"
  else
    return 1
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__zellij_list() {
  __zellij_get_all_sessions 2>/dev/null
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__zellij_conf() {
  [ -n "$1" ] && [ -n "$ZELLIJ_NEW_NAME" ] || ZELLIJ_NEW_NAME="${1:-${ZELLIJ_NEW_NAME:-default}}"
  if [ -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ]; then
    return 0
  fi
  return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__launch_zellij() {
  [ -n "$1" ] && [ -n "$ZELLIJ_NEW_NAME" ] || ZELLIJ_NEW_NAME="${1:-${ZELLIJ_NEW_NAME:-default}}"
  [ -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ] || __printf_exit "No layout file found for $ZELLIJ_NEW_NAME"
  if [ -z "$ZELLIJ" ]; then
    __cd
    if __zellij_list 2>/dev/null | grep -qx -- "$ZELLIJ_NEW_NAME"; then
      __printf_cyan "Session '$ZELLIJ_NEW_NAME' already exists - attaching..."
      zellij attach "$ZELLIJ_NEW_NAME"
    else
      __printf_cyan "Starting new zellij session for $ZELLIJ_NEW_NAME"
      zellij --new-session-with-layout "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" --session "$ZELLIJ_NEW_NAME"
    fi
    return $?
  else
    __printf_exit "You appear to already have zellij running"
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Build a KDL layout from name:command pairs - used by the built-in presets
# when the user overrides the default tab table, and by `create`/the ad hoc
# fallback path. Plain-shell tabs stay bare (no pane block, native shell on
# open); any other command is wrapped in a bash -c pane so the tab stays
# open after the command exits (mirrors tmux-new's `remain-on-exit`)
__create_windows() {
  local wname wcmd wnum=0 add_tabs="" && shift 1
  if [ $# -ne 0 ]; then
    for window in "$@"; do
      [ -n "$window" ] || continue
      wnum=$((wnum + 1))
      wname="${window%%:*}"
      [ "$wname" != "$window" ] || wname="tab$wnum"
      wcmd="${window#*:}"
      [ "$wcmd" != "$window" ] || wcmd="${SHELL:-bash}"
      if [ "$wcmd" = "$SHELL" ] || [ "$wcmd" = "bash" ] || [ "$wcmd" = "/bin/bash" ]; then
        add_tabs+="    tab name=\"$wname\" cwd=\"$ZELLIJ_NEW_CWD\"
"
      else
        wcmd="${wcmd//\"/\\\"}"
        add_tabs+="    tab name=\"$wname\" cwd=\"$ZELLIJ_NEW_CWD\" {
        pane {
            command \"bash\"
            args \"-c\" \"$wcmd; exec bash\"
        }
    }
"
      fi
    done
  fi
  mkdir -p "$ZELLIJ_NEW_FILE_LAYOUTS" 2>/dev/null
  __printf_green "Creating zellij layout file"
  cat <<EOF >"$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl"
// Layout config for $ZELLIJ_NEW_NAME
// Generated by zellij-new

layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
$add_tabs}
EOF
  [ -s "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ] && __printf_blue "zellij layout file has been created" || __printf_exit "Failed to create zellij layout file"
  return
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__edit() {
  [ -n "$EDITOR" ] || __printf_exit "EDITOR is not set"
  [ -n "$1" ] && [ -n "$ZELLIJ_NEW_NAME" ] || ZELLIJ_NEW_NAME="${1:-${ZELLIJ_NEW_NAME:-default}}"
  [ -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ] || __printf_exit "Missing: $ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl"
  "$EDITOR" "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl"
  return $?
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Refresh the bootstrap zellij.conf from the shipped source template
__update_template() {
  local src="$CASJAYSDEVDIR/templates/zellij/new.conf"
  if [ -f "$src" ]; then
    __printf_cyan "Updating template from source..."
    if __zellij_install_conf "$src" "$ZELLIJ_CONFIG_DIR/zellij.conf"; then
      __printf_green "Template updated successfully"
      return 0
    else
      __printf_red "Failed to update template"
      return 1
    fi
  else
    __printf_red "Source template not found: $src"
    return 1
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Refresh every saved per-session layout that matches a known built-in
# preset from its shipped source; unrecognized/custom layouts are skipped
__update_all_configs() {
  local updated=0
  local failed=0
  local skipped=0

  if [ ! -d "$ZELLIJ_NEW_FILE_LAYOUTS" ]; then
    __printf_red "No layouts directory found"
    return 1
  fi

  __printf_cyan "Updating all session layouts from shipped presets..."

  for layout_file in "$ZELLIJ_NEW_FILE_LAYOUTS"/*.kdl; do
    [ -f "$layout_file" ] || continue
    local _tmp="${layout_file##*/}"
    local session_name="${_tmp%.kdl}"
    local preset="${session_name%%-*}"
    if [ -f "$CASJAYSDEVDIR/templates/zellij/layouts/$preset.kdl" ]; then
      __printf_blue "Updating layout for session: $session_name"
      if __zellij_install_layout "$preset" "$session_name"; then
        __printf_green "Updated: $session_name"
        updated=$((updated + 1))
      else
        __printf_red "Failed: $session_name"
        failed=$((failed + 1))
      fi
    else
      skipped=$((skipped + 1))
    fi
  done

  __printf_cyan "Update complete: $updated updated, $failed failed, $skipped skipped (custom layouts)"

  if [ $failed -eq 0 ]; then
    return 0
  else
    return 1
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__zellij_attach() {
  local name="${1:-$(__zellij_list | tail -n1)}"
  [ -n "$name" ] || return 1
  zellij attach "$name"
  return $?
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__zellij_ssh() {
  local ssh_session="$(__zellij_get_all_sessions | grep -x -- 'ssh')"
  [ -n "$ssh_session" ] && zellij attach ssh || return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Session management functions
__zellij_switch() {
  local session="${1:-$(__zellij_list | { command -v fzf &>/dev/null && fzf || head -n1; })}"
  [ -n "$session" ] || {
    __printf_red "No session specified or available"
    return 1
  }

  if ! __zellij_get_all_sessions | grep -qx -- "$session"; then
    __printf_red "Session '$session' does not exist"
    return 1
  fi

  if [ -n "$ZELLIJ" ]; then
    zellij action switch-session "$session"
  else
    zellij attach "$session"
  fi
  return $?
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# zellij can only rename the CURRENTLY ATTACHED session (`zellij action
# rename-session` carries no session-target flag, verified via
# `zellij action rename-session --help`) - if we are attached to the exact
# session being renamed, run the action directly; otherwise this is a
# genuine gap and the user is told exactly what to run once attached
__zellij_rename() {
  local old_name="${1}"
  local new_name="${2}"
  [ -n "$old_name" ] && [ -n "$new_name" ] || {
    __printf_red "Usage: zellij-new rename <old_name> <new_name>"
    return 1
  }

  if ! __zellij_get_all_sessions | grep -qx -- "$old_name"; then
    __printf_red "Session '$old_name' does not exist"
    return 1
  fi

  if [ -n "$ZELLIJ" ] && [ "$ZELLIJ_SESSION_NAME" = "$old_name" ]; then
    zellij action rename-session "$new_name"
    return $?
  fi

  __printf_yellow "Zellij can only rename the session you're currently attached to"
  __printf_cyan "Attach with: zellij-new attach $old_name"
  __printf_cyan "Then run:    zellij action rename-session $new_name"
  return 1
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__zellij_status() {
  local sessions="$(__zellij_list)"
  if [ -n "$sessions" ]; then
    __printf_blue "Active zellij sessions:"
    zellij list-sessions 2>/dev/null | while read -r line; do
      __printf_green "  $line"
    done
  else
    __printf_yellow "No active zellij sessions"
    return 1
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
__zellij_clone() {
  local source="$1"
  local target="$2"
  [ -n "$source" ] && [ -n "$target" ] || {
    __printf_red "Usage: zellij-new clone <source> <target>"
    return 1
  }

  if ! __zellij_get_all_sessions | grep -qx -- "$source"; then
    __printf_red "Source session '$source' does not exist"
    return 1
  fi

  if __zellij_get_all_sessions | grep -qx -- "$target"; then
    __printf_red "Target session '$target' already exists"
    return 1
  fi

  if [ -f "$ZELLIJ_NEW_FILE_LAYOUTS/$source.kdl" ]; then
    cp "$ZELLIJ_NEW_FILE_LAYOUTS/$source.kdl" "$ZELLIJ_NEW_FILE_LAYOUTS/$target.kdl"
    __launch_zellij "$target"
    __printf_green "Session '$source' cloned to '$target'"
  else
    __printf_red "Cannot clone - config files not found for '$source'"
    return 1
  fi
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Session tuned for running inside another zellij session. Uses a config
# that does not rebind the mode-entry key, so it never collides with an
# outer session's Ctrl-Space prefix. There is no tmux-style `new-session
# -d`/`send-keys`/`switch-client` in zellij - `attach -c` both creates (if
# missing) and attaches, whether nested or not, so a single code path
# covers both cases
__zellij_nested() {
  local name="${1:-nested-${ZELLIJ_NEW_CWD##*/}}"
  local nested_conf="$CASJAYSDEVDIR/templates/zellij/nested.conf"
  [ -f "$nested_conf" ] || __printf_exit "Missing nested config: $nested_conf"
  if [ -n "$ZELLIJ" ]; then
    __printf_cyan "Starting nested zellij session '$name' inside the current session"
  else
    __printf_cyan "Starting zellij session '$name' (nesting-ready config)"
  fi
  zellij -c "$nested_conf" attach -c "$name"
  return $?
}
