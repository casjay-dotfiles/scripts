# Migrate old plugin directory to new global location
if [ -d "$HOME/.local/share/zellij/plugins/zellij-new" ]; then
  __printf_cyan "Removing old plugin directory: ~/.local/share/zellij/plugins/zellij-new"
  rm -rf "$HOME/.local/share/zellij/plugins/zellij-new"
fi
# - - - - - - - - - - - - - - - - - - - - - - - - -
# export variables
export RUN_OPTIONS_NO_MESSAGE="${RUN_OPTIONS_NO_MESSAGE:-true}"
