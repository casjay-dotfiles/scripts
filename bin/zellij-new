APPNAME="${0##*/}"
VERSION="202609031457-git"
USER="${SUDO_USER:-$USER}"
RUN_USER="${RUN_USER:-$USER}"
USER_HOME="${USER_HOME:-$HOME}"
SCRIPT_SRC_DIR="${BASH_SOURCE%/*}"
ZELLIJ_NEW_REQUIRE_SUDO="${ZELLIJ_NEW_REQUIRE_SUDO:-no}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Reopen in a terminal
if [ ! -t 0 ] && { [ "$1" = --term ] || [ $# = 0 ]; }; then
  { [ "$1" = --term ] && shift 1 || true; } && TERMINAL_APP="TRUE" myterminal -e "$APPNAME $*" && exit 0 || exit 1
fi
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Set script title
export CASJAYSDEV_TITLE_PREV="${CASJAYSDEV_TITLE_PREV:-${CASJAYSDEV_TITLE_SET:-$APPNAME}}" CASJAYSDEV_TITLE_SET
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Initial debugging
[ "$1" = "--debug" ] && set -x && export SCRIPT_OPTS="--debug" && export _DEBUG="on"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Disables colorization
[ "$1" = "--no-color" ] && export SHOW_RAW="true"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# pipes fail
set -o pipefail
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Send all output to /dev/null
__devnull() {
  local exitCode
  tee &>/dev/null && exitCode=0 || exitCode=1
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Send errors to /dev/null
__devnull2() {
  [ -n "$1" ] && local cmd="$1" && shift 1 || return 1
  local exitCode
  "$cmd" "$@" 2>/dev/null && exitCode=0 || exitCode=1
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# See if the executable exists
__cmd_exists() {
  local exitCode=0
  [ -n "$1" ] || return 0
  for cmd in "$@"; do
    if builtin command -v "$cmd" &>/dev/null; then
      exitCode=$((exitCode + 0))
    else
      exitCode=$((exitCode + 1))
    fi
  done
  [ $exitCode -eq 0 ] || exitCode=1
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Check for a valid internet connection
__am_i_online() {
  local exitCode=0
  curl -q -LSsfI --max-time 2 --retry 1 "${1:-https://1.1.1.1}" 2>&1 | grep -qi -- 'server:.*cloudflare' || exitCode=4
  return ${exitCode:-0}
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# colorization
if [ -n "${NO_COLOR+x}" ] || [ "$SHOW_RAW" = "true" ]; then
  NC=""
  RESET=""
  BLACK=""
  RED=""
  GREEN=""
  YELLOW=""
  BLUE=""
  PURPLE=""
  CYAN=""
  WHITE=""
  ORANGE=""
  LIGHTRED=""
  BG_GREEN=""
  BG_RED=""
  ICON_INFO="[ info ]"
  ICON_GOOD="[ ok ]"
  ICON_WARN="[ warn ]"
  ICON_ERROR="[ error ]"
  ICON_QUESTION="[ ? ]"
  printf_column() { tee | grep -- '^'; }
  printf_color() { printf '%b' "$1" | tr -d '\t' | sed '/^%b$/d;s,\x1B\[[0-9;]*[a-zA-Z],,g'; }
else
  printf_column() { column -t 2>/dev/null; }
  printf_color() { printf "%b" "$(tput setaf "${2:-7}" 2>/dev/null)" "$1" "$(tput sgr0 2>/dev/null)"; }
fi
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Color printf functions
__printf_blue() { printf_color "$1\n" 4; }
__printf_cyan() { printf_color "$1\n" 6; }
__printf_green() { printf_color "$1\n" 2; }
__printf_yellow() { printf_color "$1\n" 3; }
__printf_red() { printf_color "$1\n" 1; }
__printf_purple() { printf_color "$1\n" 5; }
__printf_newline() { printf '\n'; }
__printf_readline() { printf '%s\n' "$(cat -)"; }
__printf_exit() { __printf_red "$1" && exit ${2:-1}; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Additional printf_ colors
__printf_head() { __printf_blue "$1"; }
__printf_opts() { __printf_purple "$1"; }
__printf_line() { __printf_cyan "$1"; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
# output version
__version() { __printf_cyan "$VERSION"; }
# - - - - - - - - - - - - - - - - - - - - - - - - -
# list options
__list_options() {
  printf_color "$1: " "$5"
  echo -ne "$2" | sed 's|:||g;s/'$3'/ '$4'/g' | tr '\n' ' '
  __printf_newline
}
# - - - - - - - - - - - - - - - - - - - - - - - - -
# create the config file
__gen_config() {
  local NOTIFY_CLIENT_NAME="$APPNAME"
  if [ "$INIT_CONFIG" != "TRUE" ]; then
    __printf_blue "Generating the config file in"
    __printf_cyan "$ZELLIJ_NEW_CONFIG_DIR/$ZELLIJ_NEW_CONFIG_FILE"
  fi
  mkdir -p "$ZELLIJ_NEW_CONFIG_DIR" "$ZELLIJ_NEW_CONFIG_BACKUP_DIR" 2>/dev/null
  [ -f "$ZELLIJ_NEW_CONFIG_DIR/$ZELLIJ_NEW_CONFIG_FILE" ] &&
    cp -Rf "$ZELLIJ_NEW_CONFIG_DIR/$ZELLIJ_NEW_CONFIG_FILE" "$ZELLIJ_NEW_CONFIG_BACKUP_DIR/$ZELLIJ_NEW_CONFIG_FILE.$$" 2>/dev/null
  cat <<EOF >"$ZELLIJ_NEW_CONFIG_DIR/$ZELLIJ_NEW_CONFIG_FILE"
# Settings for zellij-new
ZELLIJ_NEW_CONFIG_DIR="${ZELLIJ_NEW_CONFIG_DIR:-}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Project directory options
RUN_OPTIONS_DIRS_PROJECTS="${RUN_OPTIONS_DIRS_PROJECTS:-}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Docker Project directory options
RUN_OPTIONS_DIRS_DOCKER_SRC="${RUN_OPTIONS_DIRS_DOCKER_SRC:-}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Github Project directory options
RUN_OPTIONS_DIRS_GITHUB_DOCKERMGR="${RUN_OPTIONS_DIRS_GITHUB_DOCKERMGR:-}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Programs logging Directories
RUN_OPTIONS_LOGS_BUILDX="${RUN_OPTIONS_LOGS_BUILDX:-}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Color Settings
ZELLIJ_NEW_OUTPUT_COLOR_1="${ZELLIJ_NEW_OUTPUT_COLOR_1:-}"
ZELLIJ_NEW_OUTPUT_COLOR_2="${ZELLIJ_NEW_OUTPUT_COLOR_2:-}"
ZELLIJ_NEW_OUTPUT_COLOR_GOOD="${ZELLIJ_NEW_OUTPUT_COLOR_GOOD:-}"
ZELLIJ_NEW_OUTPUT_COLOR_ERROR="${ZELLIJ_NEW_OUTPUT_COLOR_ERROR:-}"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# Notification Settings
ZELLIJ_NEW_NOTIFY_ENABLED="${ZELLIJ_NEW_NOTIFY_ENABLED:-}"
ZELLIJ_NEW_GOOD_NAME="${ZELLIJ_NEW_GOOD_NAME:-}"
ZELLIJ_NEW_ERROR_NAME="${ZELLIJ_NEW_ERROR_NAME:-}"
ZELLIJ_NEW_GOOD_MESSAGE="${ZELLIJ_NEW_GOOD_MESSAGE:-}"
ZELLIJ_NEW_ERROR_MESSAGE="${ZELLIJ_NEW_ERROR_MESSAGE:-}"
ZELLIJ_NEW_NOTIFY_CLIENT_NAME="${ZELLIJ_NEW_NOTIFY_CLIENT_NAME:-}"
ZELLIJ_NEW_NOTIFY_CLIENT_ICON="${ZELLIJ_NEW_NOTIFY_CLIENT_ICON:-}"
ZELLIJ_NEW_NOTIFY_CLIENT_URGENCY="${ZELLIJ_NEW_NOTIFY_CLIENT_URGENCY:-}"

EOF
  if builtin type -t __gen_config_local | grep -q -- 'function'; then __gen_config_local; fi
  if [ -f "$ZELLIJ_NEW_CONFIG_DIR/$ZELLIJ_NEW_CONFIG_FILE" ]; then
    [ "$INIT_CONFIG" = "TRUE" ] || __printf_green "Your config file for $APPNAME has been created"
    . "$ZELLIJ_NEW_CONFIG_DIR/$ZELLIJ_NEW_CONFIG_FILE"
    exitCode=0
  else
    __printf_red "Failed to create the config file"
    exitCode=1
  fi
  return ${exitCode:-0}
}
