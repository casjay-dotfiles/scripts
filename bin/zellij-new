# Execute functions
[ -z "$ZELLIJ_NEW_CWD" ] || __cd "$ZELLIJ_NEW_CWD"
# - - - - - - - - - - - - - - - - - - - - - - - - -
# begin main app
case "$1" in
kill)
  shift 1
  __zellij_kill "$@"
  exit $?
  ;;
clean)
  shift 1
  if [ -n "$(ls -A "$HOME/.config/myscripts/zellij-new"/*/* 2>/dev/null)" ]; then
    for file in "$HOME"/.config/myscripts/zellij-new/*/*; do __printf_blue "Deleting $file" && rm -R "$file"; done
  else
    __printf_yellow "There are no config files in $HOME/.config/myscripts/zellij-new/*/*"
  fi
  exit 0
  ;;
list | ls)
  shift 1
  __zellij_list | __printf_readline || __printf_exit "There are no current zellij sessions"
  exit $?
  ;;
attach | a)
  shift 1
  if [ "$1" = "ssh" ]; then
    __zellij_ssh || __printf_exit "No 'ssh' session found - run: zellij-new ssh"
    exit $?
  else
    __zellij_attach "$1" || __printf_exit "There are no current zellij sessions"
    exit $?
  fi
  ;;
switch | sw)
  shift 1
  __zellij_switch "$1"
  exit $?
  ;;
rename | mv)
  shift 1
  __zellij_rename "$1" "$2"
  exit $?
  ;;
status | info)
  shift 1
  __zellij_status
  exit $?
  ;;
clone | copy)
  shift 1
  __zellij_clone "$1" "$2"
  exit $?
  ;;
nested)
  shift 1
  __zellij_nested "$1"
  exit $?
  ;;
ai)
  __init "${ZELLIJ_NEW_SET_NAME:-ai-${ZELLIJ_NEW_CWD##*/}}"
  { [ $# -gt 1 ] || [ ! -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ]; } &&
    __create_windows "ai" "${1:-ai:$SHELL}" ${2:-} ${3:-} ${4:-} ${5:-} ${6:-} ${7:-} ${8:-} ${9:-} |& __devnull
  __launch_zellij "ai"
  exit $?
  ;;
single)
  __init "${ZELLIJ_NEW_SET_NAME:-single-${ZELLIJ_NEW_CWD##*/}}"
  { [ $# -gt 1 ] || [ ! -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ]; } &&
    __create_windows "single" "${1:-main:$SHELL}" ${2:-} ${3:-} ${4:-} ${5:-} ${6:-} ${7:-} ${8:-} ${9:-} |& __devnull
  __launch_zellij "single"
  exit $?
  ;;
shell)
  shift 1
  __init "${ZELLIJ_NEW_SET_NAME:-shell-${ZELLIJ_NEW_CWD##*/}}"
  { [ $# -gt 0 ] || [ ! -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ]; } &&
    __create_windows "shell" "${1:-main:$SHELL}" ${2:-} ${3:-} ${4:-} ${5:-} ${6:-} ${7:-} ${8:-} ${9:-} |& __devnull
  __launch_zellij "shell"
  exit $?
  ;;
server)
  shift 1
  run_server --silent source "$ZELLIJ_NEW_TEMP_FILE" |& __devnull
  if [ -f "$ZELLIJ_NEW_TEMP_FILE" ]; then
    . "$ZELLIJ_NEW_TEMP_FILE"
  fi
  __init "${ZELLIJ_NEW_SET_NAME:-server-${ZELLIJ_NEW_CWD##*/}}"
  set_cwd="$ZELLIJ_NEW_CWD"
  set_port="$RUN_SERVER_PORT"
  set_logfile="$RUN_SERVER_LOG"
  set_name="${SERVER_NAME:-server}"
  set_url="${RUN_SERVER_URL:-http://localhost:19922}"
  __create_windows "$set_name" "${1:-shell:$SHELL}" \
    "${2:-editor:"run_options editor $set_cwd"}" \
    "${3:-filemanager:"run_options files $set_cwd"}" \
    "${4:-browser:"run_options browser $set_url"}" \
    "${5:-server:"run_options server $set_cwd $set_port"}" \
    "${6:-logs:"run_options log $set_logfile"}" |& __devnull
  __launch_zellij "$set_name"
  exit $?
  ;;
web)
  shift 1
  run_server --silent source "$ZELLIJ_NEW_TEMP_FILE" |& __devnull
  if [ -f "$ZELLIJ_NEW_TEMP_FILE" ]; then
    . "$ZELLIJ_NEW_TEMP_FILE"
  fi
  __init "${ZELLIJ_NEW_SET_NAME:-web-${ZELLIJ_NEW_CWD##*/}}"
  set_cwd="$RUN_SERVER_CWD"
  set_port="$RUN_SERVER_PORT"
  set_logfile="$RUN_SERVER_LOG"
  set_name="${SERVER_NAME:-web}"
  set_url="${RUN_SERVER_URL:-http://localhost:19922}"
  __create_windows "$set_name" "${1:-shell:$SHELL}" \
    "${2:-editor:"run_options editor $set_cwd"}" \
    "${3:-filemanager:"run_options files $set_cwd"}" \
    "${4:-browser:"run_options browser $set_url"}" \
    "${5:-server:"run_options server $set_cwd $set_port"}" \
    "${6:-logs:"run_options log $set_logfile"}" |& __devnull
  __launch_zellij "$set_name"
  exit $?
  ;;
docker)
  shift 1
  __init "${ZELLIJ_NEW_SET_NAME:-docker-${ZELLIJ_NEW_CWD##*/}}"
  { [ $# -gt 0 ] || [ ! -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ]; } &&
    __create_windows "docker" "${1:-shell:"run_options cd $PWD"}" \
      "${2:-mgr:"run_options cd $RUN_OPTIONS_DIRS_GITHUB_DOCKERMGR"}" \
      "${3:-devel:"run_options exec cdd buildx"}" \
      "${4:-editor:"run_options cd $RUN_OPTIONS_DIRS_DOCKER_SRC"}" \
      "${5:-build:"run_options cd $RUN_OPTIONS_DIRS_DOCKER_SRC"}" \
      "${6:-testing:"run_options cd $RUN_OPTIONS_DIRS_DOCKER_SRC"}" \
      "${7:-docker:"run_options cd $RUN_OPTIONS_DIRS_DOCKER_SRC"}" \
      "${8:-logging:"run_options log $RUN_OPTIONS_LOGS_BUILDX"}" \
      "${9:-remote:"run_options ssh"}" |& __devnull
  __launch_zellij "docker"
  exit $?
  ;;
dev)
  shift 1
  __init "${ZELLIJ_NEW_SET_NAME:-dev-${ZELLIJ_NEW_CWD##*/}}"
  { [ $# -gt 0 ] || [ ! -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ]; } &&
    __create_windows "dev" "${1:-dev:$SHELL}" "${2:-editor:$SHELL}" \
      "${3:-logging:$SHELL}" "${4:-server:$SHELL}" ${5:-} ${6:-} ${7:-} ${8:-} ${9:-} |& __devnull
  __launch_zellij "dev"
  exit $?
  ;;
go)
  shift 1
  __init "${ZELLIJ_NEW_SET_NAME:-go-${ZELLIJ_NEW_CWD##*/}}"
  { [ $# -gt 0 ] || [ ! -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ]; } &&
    __create_windows "go" "${1:-main:"go run ."}" "${2:-test:"go test ./..."}" \
      "${3:-mod:"go mod tidy"}" "${4:-editor:$SHELL}" "${5:-docs:"go doc"}" |& __devnull
  __launch_zellij "go"
  exit $?
  ;;
rust)
  shift 1
  __init "${ZELLIJ_NEW_SET_NAME:-rust-${ZELLIJ_NEW_CWD##*/}}"
  { [ $# -gt 0 ] || [ ! -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ]; } &&
    __create_windows "rust" "${1:-build:"cargo build"}" "${2:-run:"cargo run"}" \
      "${3:-test:"cargo test"}" "${4:-editor:$SHELL}" "${5:-clippy:"cargo clippy"}" \
      "${6:-fmt:"cargo fmt"}" |& __devnull
  __launch_zellij "rust"
  exit $?
  ;;
python)
  shift 1
  __init "${ZELLIJ_NEW_SET_NAME:-python-${ZELLIJ_NEW_CWD##*/}}"
  { [ $# -gt 0 ] || [ ! -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ]; } &&
    __create_windows "python" "${1:-main:"python main.py"}" "${2:-test:"python -m pytest"}" \
      "${3:-venv:"python -m venv venv && source venv/bin/activate"}" "${4:-editor:$SHELL}" \
      "${5:-jupyter:"jupyter notebook"}" |& __devnull
  __launch_zellij "python"
  exit $?
  ;;
devops)
  shift 1
  __init "${ZELLIJ_NEW_SET_NAME:-devops-${ZELLIJ_NEW_CWD##*/}}"
  { [ $# -gt 0 ] || [ ! -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ]; } &&
    __create_windows "devops" \
      "${1:-kubectl:"kubectl get pods"}" \
      "${2:-docker:"docker ps"}" \
      "${3:-terraform:"terraform plan"}" \
      "${4:-ansible:$SHELL}" \
      "${5:-monitoring:"htop"}" \
      "${6:-logs:"journalctl -f"}" |& __devnull
  __launch_zellij "devops"
  exit $?
  ;;
monitoring)
  shift 1
  __init "${ZELLIJ_NEW_SET_NAME:-monitoring-${ZELLIJ_NEW_CWD##*/}}"
  { [ $# -gt 0 ] || [ ! -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ]; } &&
    __create_windows "monitoring" \
      "${1:-htop:htop}" \
      "${2:-logs:"journalctl -f"}" \
      "${3:-docker:"docker stats"}" \
      "${4:-network:"watch ss -tuln"}" \
      "${5:-disk:"watch df -h"}" |& __devnull
  __launch_zellij "monitoring"
  exit $?
  ;;
database)
  shift 1
  __init "${ZELLIJ_NEW_SET_NAME:-database-${ZELLIJ_NEW_CWD##*/}}"
  { [ $# -gt 0 ] || [ ! -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ]; } &&
    __create_windows "database" "${1:-mysql:"mysql -u root"}" "${2:-postgres:"psql"}" "${3:-redis:"redis-cli"}" "${4:-mongo:"mongosh"}" "${5:-editor:$SHELL}" |& __devnull
  __launch_zellij "database"
  exit $?
  ;;
rpm)
  shift 1
  __init "${ZELLIJ_NEW_SET_NAME:-rpm-${ZELLIJ_NEW_CWD##*/}}"
  [ -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ] ||
    __create_windows "rpm" "main:$SHELL" "tools:$SHELL" "edit:$SHELL" "8-arm64:$SHELL" "8-amd64:$SHELL" "9-arm64:$SHELL" "9-amd64:$SHELL" "git:$SHELL" "logs:$SHELL" |& __devnull
  __launch_zellij "rpm"
  exit $?
  ;;
node)
  shift 1
  __init "${ZELLIJ_NEW_SET_NAME:-node-${ZELLIJ_NEW_CWD##*/}}"
  { [ $# -gt 0 ] || [ ! -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ]; } &&
    __create_windows "node" "${1:-devel:$SHELL}" "${2:-editor:$SHELL}" "${3:-client:$SHELL}" "${4:-server:$SHELL}" "${5:-database:$SHELL}" ${6:-} ${7:-} ${8:-} ${9:-} |& __devnull
  __launch_zellij "node"
  exit $?
  ;;
