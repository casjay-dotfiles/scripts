  shift 1
  __init "${ZELLIJ_NEW_SET_NAME:-bun-${ZELLIJ_NEW_CWD##*/}}"
  { [ $# -gt 0 ] || [ ! -f "$ZELLIJ_NEW_FILE_LAYOUTS/$ZELLIJ_NEW_NAME.kdl" ]; } &&
