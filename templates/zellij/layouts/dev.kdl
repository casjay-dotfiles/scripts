layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="dev" cwd="ZELLIJ_NEW_CWD"
    tab name="editor" cwd="ZELLIJ_NEW_CWD"
    tab name="logging" cwd="ZELLIJ_NEW_CWD"
    tab name="server" cwd="ZELLIJ_NEW_CWD"
}
