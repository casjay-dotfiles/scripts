layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="htop" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "htop; exec bash"
        }
    }
    tab name="logs" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "journalctl -f; exec bash"
        }
    }
    tab name="docker" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "docker stats; exec bash"
        }
    }
    tab name="network" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "watch ss -tuln; exec bash"
        }
    }
    tab name="disk" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "watch df -h; exec bash"
        }
    }
}
