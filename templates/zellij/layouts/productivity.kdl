layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="todo" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "run_options loop todo; exec bash"
        }
    }
    tab name="notes" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "run_options loop notes; exec bash"
        }
    }
    tab name="scratchpad" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "run_options loop scratchpad; exec bash"
        }
    }
    tab name="tasks" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "run_options loop tasks; exec bash"
        }
    }
    tab name="blog" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "run_options shell; exec bash"
        }
    }
    tab name="tools" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "run_options shell; exec bash"
        }
    }
    tab name="weather" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "run_options shell weather; exec bash"
        }
    }
}
