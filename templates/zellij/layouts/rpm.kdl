layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="main" cwd="ZELLIJ_NEW_CWD"
    tab name="tools" cwd="ZELLIJ_NEW_CWD"
    tab name="edit" cwd="ZELLIJ_NEW_CWD"
    tab name="8-arm64" cwd="ZELLIJ_NEW_CWD"
    tab name="8-amd64" cwd="ZELLIJ_NEW_CWD"
    tab name="9-arm64" cwd="ZELLIJ_NEW_CWD"
    tab name="9-amd64" cwd="ZELLIJ_NEW_CWD"
    tab name="git" cwd="ZELLIJ_NEW_CWD"
    tab name="logs" cwd="ZELLIJ_NEW_CWD"
}
