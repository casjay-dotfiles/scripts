layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="1" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "run_options ssh; exec bash"
        }
    }
    tab name="2" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "run_options ssh; exec bash"
        }
    }
    tab name="3" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "run_options ssh; exec bash"
        }
    }
    tab name="4" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "run_options ssh; exec bash"
        }
    }
    tab name="5" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "run_options ssh; exec bash"
        }
    }
    tab name="6" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "run_options ssh; exec bash"
        }
    }
    tab name="7" cwd="ZELLIJ_NEW_CWD" {
        pane {
            command "bash"
            args "-c" "run_options ssh; exec bash"
        }
    }
}
